#!/usr/bin/perl

# pve-meta: read a metadata document from the node it runs on.
#
# Installed at /usr/sbin/pve-meta. **A local reader, not an API client**: it
# calls PVE::RS::Meta directly against /etc/pve/meta, so it needs no ticket, no
# token and no pveproxy, and it works in a hook script that runs before the API
# is reachable. That is the whole reason it exists --
# `pvesh get /meta/guests/<vmid>` already does this for anyone who has an API
# session, and a hook script does not.
#
# It therefore enforces **nothing**. It is root reading a file root can already
# `cat`, and it is refused to anyone else by the permissions on /etc/pve. The
# access rules in docs/DESIGN.md section 4 are about the API, where a principal
# other than root exists to be limited; there is no principal here.
#
# `set`, `merge` and `delete` are the API's PUT and DELETE, for root on the node:
# the same Rust functions, the same lint, the same digest compare-and-swap, the
# same enforced schemas (`--force` is the API's force=1), under the same
# per-document cluster lock PVE::API2::Ext::Meta holds -- so a hook script, a
# cloud-init step or an Ansible task can write without a token and without
# pveproxy. What they skip is permissions, because root can already write the
# file; the audit line still names root@pam.
#
# `ls --orphans` and `rm` are the manual cleanup for the one case the create and
# destroy hooks cannot see (docs/DESIGN.md section 9): a guest config deleted out
# of band, so destroy_config never ran and the document stayed. `rm` takes the
# document's own write lock and re-reads the vmlist inside it, so it can never
# race a PUT for a guest that came back, and it refuses a live guest outright --
# that one is removed through the API or the UI, where permissions apply.
#
# `scan-notes` is the one-time pass debian/pve-meta.postinst runs. A guest restored
# on a host without pve-meta carries its document in its notes, as the block every
# backup taken here appends (docs/LIFECYCLE.md); this reads every such block in the
# cluster back into the store and strips it.
#
# Output is shaped for the caller a hook script is:
#
#   pve-meta get 201 homelab.owner     -> arki          (a scalar, bare, no quotes)
#   pve-meta get 201 homelab           -> YAML          (anything with structure)
#   pve-meta get 201                   -> the whole document as YAML, without comment keys
#   pve-meta get 201 --comments        -> the file as it is written, notes and all
#   pve-meta get prefixes/traefik      -> a prefix definition, same as any document
#   pve-meta get nodes/pve1/prefixes/gpu -> one node's prefix file, likewise
#   pve-meta ls                        -> every document id, one per line
#   pve-meta ls --orphans              -> vmids with files but no guest in the vmlist
#   pve-meta rm 999500                 -> remove an orphan's document and snapshot copies
#   pve-meta set 201 traefik --data '{"spec":{"host":"x"}}'   -> replace that view
#   pve-meta merge 201 traefik --text 'spec: {port: 80}'      -> merge-patch into it
#   pve-meta delete 201 traefik.spec.port                      -> remove one key
#
# so `host=$(pve-meta get $vmid traefik.spec.host)` is the obvious thing and
# gives the obvious answer. Exit status 2 means "not there" -- a missing
# document, or a view the document does not have -- which is what lets a hook
# script tell "nothing configured" from "something is broken" without parsing
# the output:
#
#   if host=$(pve-meta get "$vmid" traefik.spec.host); then ... ; fi

use strict;
use warnings;

use Getopt::Long qw(GetOptionsFromArray);
use JSON::PP;
use List::Util;

use PVE::RS::Meta;

my $LOCK_TIMEOUT = 30;

my $SELF = 'pve-meta';

sub usage {
    my ($msg) = @_;
    print STDERR "$SELF: $msg\n\n" if $msg;
    print STDERR <<"EOF";
usage: $SELF get <id> [<view>] [--format yaml|json] [--comments]
       $SELF set <id> [<view>] (--data <json> | --text <yaml> | --file <path>) [--digest <d>] [--dry-run] [--force] [--comments]
       $SELF merge <id> [<view>] (--data <json> | --text <yaml> | --file <path>) [--digest <d>] [--dry-run] [--force]
       $SELF delete <id> [<view>] [--digest <d>]
       $SELF ls [--orphans] [--format plain|json]
       $SELF rm <vmid>
       $SELF scan-notes

  <id>    a vmid, 'prefixes/<name>' or 'nodes/<node>/prefixes/<name>'
  <view>  a dotted key path inside the document; omit for all of it

  get     print the view; comment keys (key__, a note about key) only with --comments
  set     replace the view with the payload ({} stores an empty map; use delete to remove);
          it may carry no comment key and keeps the stored ones whose key it keeps, unless
          --comments makes it the whole subtree, notes included
  merge   apply the payload as a merge patch (a JSON null deletes a key)
  delete  remove the view and its note (<view>__), or the whole document
  --file  read the payload from a file, or '-' for stdin; .json is JSON, anything else YAML
  --force store the result even where a prefix's schema is enforced and it does not match

  ls --orphans  only vmids the store holds files for that are not in the vmlist
  rm <vmid>     remove an orphan's document and snapshot copies; refuses a live guest
  scan-notes    read every backup notes block in the cluster's guest configs into the
                store and strip it (what the package install runs once)

exit status: 0 done, 1 error, 2 no such document, view or orphan (or nothing to delete)
EOF
    exit($msg ? 1 : 0);
}

# The one caller here is root on the node, reading files it already owns. For
# a guest the ACL carries the guest's tags and its current node, because a
# prefix's selector and its `enforce` are resolved against the tags, and the
# node decides whose prefix files join the cluster's (docs/DESIGN.md section 3)
# -- exactly as PVE::API2::Ext::Meta passes them. Called inside `locked`, after
# its cfs_update().
my $ROOT_ACL = { authid => 'root@pam', read => 1, write => 1, tags => [] };

sub acl_for {
    my ($id) = @_;
    return $ROOT_ACL if $id !~ /^\d+$/;
    require PVE::Cluster;
    my $props = eval { PVE::Cluster::get_guest_config_properties(['tags'], $id) } || {};
    my $raw = (($props->{$id} // {})->{tags}) // '';
    my @tags = grep { length($_) } split(/[;,\s]+/, $raw);
    my $vmlist = PVE::Cluster::get_vmlist() || {};
    my $node = ((($vmlist->{ids} // {})->{$id}) // {})->{node};
    return { %$ROOT_ACL, tags => \@tags, node => $node };
}

# The lock every write to this document holds, on the API and here: one domain
# per document, named the way PVE::API2::Ext::Meta names it.
sub lock_id_for {
    my ($id) = @_;
    return $id if $id =~ /^\d+$/;
    return "node-$1.prefix-$2" if $id =~ m{^nodes/([^/]*)/prefixes/(.*)$};
    my (undef, $name) = split(m{/}, $id, 2);
    return "prefix-$name";
}

# Runs $code under the document's cluster lock, with the same things the API
# checks inside it: a guest id must be in the vmlist (a write must never create a
# file for a vmid that does not exist), a set or merge of a node's prefix file must
# name a node in the cluster (a write must never create a directory for one that is
# not), and the digest is re-checked by the Rust call itself. cfs_lock_domain
# reports through $@ rather than dying.
sub locked {
    my ($id, $code, $may_create) = @_;
    require PVE::Cluster;
    my $res = PVE::Cluster::cfs_lock_domain(
        "pve-meta-" . lock_id_for($id),
        $LOCK_TIMEOUT,
        sub {
            if ($id =~ /^\d+$/) {
                PVE::Cluster::cfs_update();
                my $vmlist = PVE::Cluster::get_vmlist() || {};
                die "guest '$id' does not exist\n" if !(($vmlist->{ids} // {})->{$id});
            } elsif ($may_create && $id =~ m{^nodes/([^/]*)/}) {
                my $node = $1;
                PVE::Cluster::cfs_update();
                die "node '$node' does not exist\n"
                    if !grep { $_ eq $node } @{ PVE::Cluster::get_nodelist() // [] };
            }
            return $code->();
        },
    );
    if (my $err = $@) {
        chomp(my $msg = "$err");
        $msg =~ s/^\d{3}:\s*//;
        print STDERR "$SELF: $msg\n";
        exit 1;
    }
    return $res;
}

# The payload of a set or merge: exactly one of --data (JSON), --text (YAML) or
# --file (by extension; '-' is stdin, read as YAML). Returns (format, text).
sub write_payload {
    my ($opts) = @_;
    my $given = grep { defined $_ } @$opts{qw(data text file)};
    usage("exactly one of --data, --text or --file is required") if $given != 1;
    return ('json', $opts->{data}) if defined $opts->{data};
    return ('yaml', $opts->{text}) if defined $opts->{text};
    my $file = $opts->{file};
    my $text;
    if ($file eq '-') {
        local $/;
        $text = <STDIN>;
    } else {
        open(my $fh, '<', $file) or do { print STDERR "$SELF: $file: $!\n"; exit 1 };
        local $/;
        $text = <$fh>;
        close($fh);
    }
    return ($file =~ /\.json$/i ? 'json' : 'yaml', $text // '');
}

sub report_write {
    my ($what, $id, $view, $res) = @_;
    my $n = scalar @{ $res->{touched} || [] };
    my $where = defined($view) && $view ne '' ? " view '$view'" : '';
    print "$what $id$where: $n path(s) touched\n";
    return $n;
}

sub cmd_write {
    my ($mode, @args) = @_;
    my %opts;
    GetOptionsFromArray(\@args,
        'data=s' => \$opts{data}, 'text=s' => \$opts{text}, 'file=s' => \$opts{file},
        'digest=s' => \$opts{digest}, 'dry-run' => \$opts{dry_run}, 'force' => \$opts{force},
        ($mode eq 'set' ? ('comments' => \$opts{comments}) : ()),
    ) or usage('bad options');
    my ($id, $view) = @args;
    usage("$mode needs an id") if !defined($id);
    usage('too many arguments') if @args > 2;
    my ($format, $text) = write_payload(\%opts);

    # No `call` wrapper inside the lock: a die unwinds through cfs_lock_domain
    # and `locked` reports it, where an exit would leave the callback mid-way.
    my $res = locked($id, sub {
        return PVE::RS::Meta::api_put(
            $id, $view, $format, $text, $mode eq 'merge' ? 'merge' : 'replace',
            $opts{digest}, ($opts{dry_run} ? 1 : 0), acl_for($id), ($opts{force} ? 1 : 0),
            ($opts{comments} ? 1 : 0),
        );
    }, 1);
    report_write($opts{dry_run} ? 'would write' : 'wrote', $id, $view, $res);

    # A replace without --comments keeps the notes it did not carry; say so, since
    # the file still holds something the payload did not.
    if ($mode eq 'set' && !$opts{comments} && !$opts{dry_run}) {
        my $doc = eval { PVE::RS::Meta::api_get($id, $view, 'json', $ROOT_ACL, 1) };
        my $kept = $doc ? count_notes($doc->{data}) : 0;
        print STDERR "$SELF: kept $kept note(s) (use --comments to replace them)\n" if $kept;
    }
}

sub count_notes {
    my ($v) = @_;
    return 0 if !ref($v);
    return List::Util::sum(0, map { count_notes($_) } @$v) if ref($v) eq 'ARRAY';
    return List::Util::sum(0, map { (/__$/ ? 1 : 0) + count_notes($v->{$_}) } keys %$v);
}

sub cmd_delete {
    my (@args) = @_;
    my %opts;
    GetOptionsFromArray(\@args, 'digest=s' => \$opts{digest}) or usage('bad options');
    my ($id, $view) = @args;
    usage('delete needs an id') if !defined($id);
    usage('too many arguments') if @args > 2;

    my $res = locked($id, sub {
        return PVE::RS::Meta::api_delete($id, $view, $opts{digest}, acl_for($id));
    });
    exit 2 if !report_write('removed', $id, $view, $res);
}

# `PVE::RS::Meta` reports errors as "NNN: message" (the Rust->Perl contract).
# A CLI wants the message and a status, not a stack trace.
sub call {
    my ($code) = @_;
    my $res = eval { $code->() };
    if (my $err = $@) {
        my $msg = "$err";
        $msg =~ s/\s+$//;
        $msg =~ s/^\d{3}:\s*//;
        print STDERR "$SELF: $msg\n";
        exit 1;
    }
    return $res;
}

sub cmd_get {
    my (@args) = @_;
    my $format = 'yaml';
    my $comments = 0;
    GetOptionsFromArray(\@args, 'format=s' => \$format, 'comments' => \$comments)
        or usage('bad options');
    usage("unknown format '$format'") if $format !~ /^(yaml|json)$/;

    my ($id, $view) = @args;
    usage('get needs an id') if !defined($id);
    usage('too many arguments') if @args > 2;

    # Read as JSON first: it is the form that says whether the value has
    # structure, which decides how it should be printed.
    my $doc = call(sub { PVE::RS::Meta::api_get($id, $view, 'json', $ROOT_ACL, $comments) });
    my $data = $doc->{data};

    # A view the document does not have comes back as the empty document, which
    # is also what an empty map looks like -- the API has one answer for both
    # (docs/DESIGN.md section 7). For a *view*, treat it as absent: that is the
    # question a hook script is asking, and an empty map is not an answer it can
    # use either.
    if (defined($view) && $view ne '' && ref($data) eq 'HASH' && !%$data) {
        exit 2;
    }
    # The whole document being empty means there is no document.
    if (!defined($view) && ref($data) eq 'HASH' && !%$data && $doc->{digest} eq '') {
        exit 2;
    }

    if ($format eq 'json') {
        # Canonical, i.e. keys sorted -- deliberately *not* the document's own key
        # order, which this hash could not carry anyway: perlmod renders a document
        # as a native Perl hash, and a Perl hash has no order (two reads of one
        # document can come back in two different orders). Sorted is at least
        # stable, which is what a script diffing this output needs. The default
        # `yaml` output below is the server's canonical text and does carry the
        # document's order.
        print JSON::PP->new->canonical->encode($data), "\n";
        return;
    }
    if (!ref($data)) {
        # A scalar prints as itself: no quotes, no `--- ` document marker, so
        # `$(pve-meta get ...)` is the value and nothing else.
        print defined($data) ? "$data\n" : "\n";
        return;
    }
    my $yaml = call(sub { PVE::RS::Meta::api_get($id, $view, 'yaml', $ROOT_ACL, $comments) });
    print $yaml->{text};
}

# The vmlist as a set, freshly refreshed. cfs_update() is not optional: a process
# that has not refreshed the cached cluster filesystem state -- and this one was
# just spawned -- sees an empty list, and an empty vmlist reads as "every guest
# is gone" to anything that subtracts it.
sub live_vmids {
    require PVE::Cluster;
    PVE::Cluster::cfs_update();
    my $vmlist = PVE::Cluster::get_vmlist() || {};
    return { map { int($_) => 1 } keys %{ $vmlist->{ids} // {} } };
}

sub orphan_vmids {
    my $live = live_vmids();
    die "the vmlist is empty; refusing to call every document an orphan\n" if !%$live;
    my $stored = call(sub { PVE::RS::Meta::stored_vmids() });
    return grep { !$live->{$_} } @$stored;
}

sub cmd_ls {
    my (@args) = @_;
    my $format = 'plain';
    my $orphans = 0;
    GetOptionsFromArray(\@args, 'format=s' => \$format, 'orphans' => \$orphans)
        or usage('bad options');
    usage("unknown format '$format'") if $format !~ /^(plain|json)$/;
    usage('too many arguments') if @args;

    if ($orphans) {
        my @vmids = eval { orphan_vmids() };
        if (my $err = $@) {
            chomp $err;
            print STDERR "$SELF: $err\n";
            exit 1;
        }
        if ($format eq 'json') {
            print JSON::PP->new->canonical->encode(\@vmids), "\n";
        } else {
            print "$_\n" for @vmids;
        }
        exit 2 if !@vmids;
        return;
    }

    # The store's own walk (docs/DESIGN.md section 8), so this lists a document
    # whether or not it parses -- the one an administrator most needs to find --
    # and every node's prefix files as well as the cluster's.
    my $version = call(sub { PVE::RS::Meta::api_version(1, undef) });
    my @docs = @{ $version->{documents} || [] };
    if ($format eq 'json') {
        print JSON::PP->new->canonical->encode(\@docs), "\n";
        return;
    }
    print "$_->{id}\n" for @docs;
}

sub cmd_rm {
    my (@args) = @_;
    usage('rm needs a vmid') if !@args;
    usage('too many arguments') if @args > 1;
    my ($vmid) = @args;
    usage("'$vmid' is not a vmid") if $vmid !~ /^[1-9][0-9]*$/;
    $vmid = int($vmid);

    require PVE::Cluster;
    my $removed;
    # The document's own write lock -- the one PVE::API2::Ext::Meta holds around
    # every read-modify-write -- with the vmlist re-read inside it. A guest
    # created at this vmid after the check outside the lock would have its
    # fresh document deleted otherwise, with its PUT long since answered 200.
    #
    # cfs_lock_domain() catches the callback's die and re-raises it through $@,
    # so the call is followed by an explicit check rather than wrapped in eval.
    PVE::Cluster::cfs_lock_domain(
        "pve-meta-$vmid",
        $LOCK_TIMEOUT,
        sub {
            my $live = live_vmids();
            die "the vmlist is empty; refusing to remove anything\n" if !%$live;
            die "$vmid is a live guest; remove its metadata through the API or the UI\n"
                if $live->{$vmid};
            # "This guest is gone, remove everything it had" is exactly what the
            # destroy hook does on every destroy path PVE has.
            $removed = PVE::RS::Meta::on_destroy($vmid);
        },
    );
    if (my $err = $@) {
        chomp $err;
        $err =~ s/^\d{3}:\s*//;
        print STDERR "$SELF: $err\n";
        exit 1;
    }
    if (!$removed) {
        print STDERR "$SELF: nothing stored for $vmid\n";
        exit 2;
    }
    print "removed $removed file(s) for $vmid\n";
}

# Every guest in the cluster whose notes carry a backup block: import it where the
# store has no document for that vmid, strip it either way (docs/DESIGN.md section
# 9). Cluster-wide on purpose: /etc/pve is one filesystem, so every config is
# readable and writable from here, one install covers the cluster, and a later
# install on another node finds documents everywhere and blocks nowhere. A document
# that is already there was put there by a node that already runs pve-meta, so it
# is kept and only the block goes.
#
# The write goes to the config's own node path, never through write_config: that
# would write under this node's name, and the restore hook it carries has nothing
# left to do once the block is stripped. The guest lock is node-local, so it is
# taken for this node's own guests only; for a guest another node owns it would
# serialise nothing and leave a stray lock file. There, the meta lock serialises
# the document and the config write is the whole-file replace pmxcfs makes atomic;
# a write on the owning node in that same instant could lose one side, and the
# owning node's next scan or restore would import the same text again. An
# install-time pass over the handful of guests that carry a block is the one place
# this is accepted.
sub cmd_scan_notes {
    my (@args) = @_;
    usage('too many arguments') if @args;

    require PVE::Cluster;
    require PVE::INotify;
    require PVE::QemuConfig;
    require PVE::LXC::Config;

    my $local_node = PVE::INotify::nodename();
    PVE::Cluster::cfs_update();
    my $vmlist = PVE::Cluster::get_vmlist() || {};
    my $ids = $vmlist->{ids} // {};
    my %count = (imported => 0, stripped => 0, failed => 0);

    for my $vmid (sort { $a <=> $b } keys %$ids) {
        my ($type, $node) = @{ $ids->{$vmid} }{qw(type node)};
        my $class =
              $type eq 'qemu' ? 'PVE::QemuConfig'
            : $type eq 'lxc'  ? 'PVE::LXC::Config'
            :                   next;
        my $path = $class->cfs_config_path($vmid, $node);

        # The cheap look first, unlocked: nearly every guest has no block.
        my $conf = eval { PVE::Cluster::cfs_read_file($path) };
        next if !$conf || !defined($conf->{description});
        next if index($conf->{description}, '[pve-meta v') == -1;

        my $action = 'none';
        my $import = sub {
                    $conf = PVE::Cluster::cfs_read_file($path);
                    return if !$conf || !defined($conf->{description});
                    return if index($conf->{description}, '[pve-meta v') == -1;
                    my $res;
                    PVE::Cluster::cfs_lock_domain(
                        "pve-meta-$vmid",
                        $LOCK_TIMEOUT,
                        sub {
                            $res = PVE::RS::Meta::notes_import(
                                $vmid, $conf->{description}, 'install',
                            );
                        },
                    );
                    die $@ if $@;
                    $action = $res->{action};
                    return if !defined($res->{description});
                    if (length($res->{description})) {
                        $conf->{description} = $res->{description};
                    } else {
                        delete $conf->{description};
                    }
                    PVE::Cluster::cfs_write_file($path, $conf);
        };
        eval {
            if ($node eq $local_node) {
                $class->lock_config($vmid, $import);
            } else {
                $import->();
            }
        };
        if (my $err = $@) {
            chomp $err;
            $err =~ s/^\d{3}:\s*//;
            print STDERR "$SELF: $vmid: $err\n";
            $count{failed}++;
            next;
        }
        next if $action eq 'none';
        print "$vmid: $action\n";
        $count{$action}++;
    }

    print "scan-notes: $count{imported} imported, $count{stripped} stripped, $count{failed} failed\n";
    exit 1 if $count{failed};
}

my $cmd = shift @ARGV;
usage() if !defined($cmd) || $cmd eq 'help' || $cmd eq '--help' || $cmd eq '-h';
if ($cmd eq 'get') {
    cmd_get(@ARGV);
} elsif ($cmd eq 'set' || $cmd eq 'merge') {
    cmd_write($cmd, @ARGV);
} elsif ($cmd eq 'delete') {
    cmd_delete(@ARGV);
} elsif ($cmd eq 'ls') {
    cmd_ls(@ARGV);
} elsif ($cmd eq 'rm') {
    cmd_rm(@ARGV);
} elsif ($cmd eq 'scan-notes') {
    cmd_scan_notes(@ARGV);
} else {
    usage("unknown command '$cmd'");
}
exit 0;
