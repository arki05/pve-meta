#!/usr/bin/perl

# pve-meta: a local reader/writer for /etc/pve/meta -- no ticket, no token, no
# pveproxy, so it also works from a hook script before the API is reachable.
# `set`/`merge`/`delete` share PVE::API2::Ext::Meta's Rust calls, lock and lint
# (docs/DESIGN.md §6); root's own file permissions are the only access check.

use strict;
use warnings;

use Getopt::Long qw(GetOptionsFromArray);
use JSON::PP;

use PVE::RS::Meta;

my $LOCK_TIMEOUT = 30;

my $SELF = 'pve-meta';

sub usage {
    my ($msg) = @_;
    print STDERR "$SELF: $msg\n\n" if $msg;
    print STDERR <<"EOF";
usage: $SELF get <id> [<view>] [--format yaml|json] [--comments]
       $SELF set <id> [<view>] (--data <json> | --text <yaml> | --file <path>) [--digest <d>] [--dry-run] [--force] [--comments]
       $SELF merge <id> [<view>] (--data <json> | --text <yaml> | --file <path>) [--digest <d>] [--dry-run] [--force]
       $SELF delete <id> [<view>] [--digest <d>]
       $SELF ls [--orphans] [--format plain|json]
       $SELF rm <vmid>
       $SELF scan-notes

  <id>    a vmid or 'prefixes/<name>'
  <view>  a dotted key path inside the document; omit for all of it

  get     print the view; comment keys (key__, a note about key) only with --comments,
          which also prints a document that does not parse as its raw text
  set     replace the view with the payload ({} stores an empty map; use delete to remove);
          it keeps the stored note of every key it keeps, unless --comments makes it the
          whole subtree, notes included
  merge   apply the payload as a merge patch (a JSON null deletes a key)
  delete  remove the view and its note (<view>__), or the whole document
  --file  read the payload from a file, or '-' for stdin; .json is JSON, anything else YAML
  --force store the result even where a prefix's schema is enforced and it does not match

  ls            every document, plus every file under /etc/pve/meta that is neither a
                document nor a snapshot copy, as 'unknown/<file>': never touched, never
                an orphan, but a typo'd name is only visible here
  ls --orphans  only vmids the store holds files for that are not in the vmlist
  rm <vmid>     remove an orphan's document and snapshot copies; refuses a live guest
  scan-notes    read every backup notes block in the cluster's guest configs into the
                store and strip it (what the package install runs once)

exit status: 0 done, 1 error, 2 no such document, view or orphan (or nothing to delete)
EOF
    exit($msg ? 1 : 0);
}

# root on the node, reading files it already owns; for a guest the tags and
# node travel too, since a prefix's selector and node override resolve
# against them the same way PVE::API2::Ext::Meta resolves them.
my $ROOT_ACL = { authid => 'root@pam', read => 1, write => 1, tags => [] };

sub acl_for {
    my ($id) = @_;
    require PVE::API2::Ext::Meta;
    return $ROOT_ACL if !PVE::API2::Ext::Meta::is_guest_id($id);
    return {
        %$ROOT_ACL,
        tags => PVE::API2::Ext::Meta::guest_tags($id),
        node => PVE::API2::Ext::Meta::guest_node($id),
    };
}

# Prints a failure the way every command reports one -- the message, without
# the Rust layer's "NNN: " status -- and exits 1.
sub fail {
    my ($err) = @_;
    require PVE::API2::Ext::Meta;
    my (undef, $msg) = PVE::API2::Ext::Meta::parse_rs_error($err);
    print STDERR "$SELF: $msg\n";
    exit 1;
}

# Runs $code under the document's cluster lock, the API's own lock domain; a
# die inside it, or a lock that cannot be taken, is a failure.
sub with_lock {
    my ($id, $code) = @_;
    require PVE::Cluster;
    require PVE::API2::Ext::Meta;
    my $res = PVE::Cluster::cfs_lock_domain(
        PVE::API2::Ext::Meta::lock_domain_for($id), $LOCK_TIMEOUT, $code,
    );
    fail($@) if $@;
    return $res;
}

# with_lock, plus the vmlist check the API makes inside it: a write never
# creates a file for a vmid that does not exist. The digest is re-checked by
# the Rust call itself.
sub locked {
    my ($id, $code) = @_;
    return with_lock($id, sub {
        die "guest '$id' does not exist\n"
            if PVE::API2::Ext::Meta::is_guest_id($id)
            && !PVE::API2::Ext::Meta::vmlist_ids(1)->{$id};
        return $code->();
    });
}

# The payload of a set or merge: exactly one of --data (JSON), --text (YAML) or
# --file (by extension; '-' is stdin, read as YAML). Returns (format, text).
sub write_payload {
    my ($opts) = @_;
    require PVE::API2::Ext::Meta;
    my $key = PVE::API2::Ext::Meta::require_one_of($opts, [qw(data text file)], sub {
        usage("exactly one of --data, --text or --file is required");
    });
    return ('json', $opts->{data}) if $key eq 'data';
    return ('yaml', $opts->{text}) if $key eq 'text';
    my $file = $opts->{file};
    my $text;
    if ($file eq '-') {
        local $/;
        $text = <STDIN>;
    } else {
        open(my $fh, '<', $file) or do { print STDERR "$SELF: $file: $!\n"; exit 1 };
        local $/;
        $text = <$fh>;
        close($fh);
    }
    return ($file =~ /\.json$/i ? 'json' : 'yaml', $text // '');
}

sub report_write {
    my ($what, $id, $view, $res) = @_;
    my $n = scalar @{ $res->{touched} || [] };
    my $where = defined($view) && $view ne '' ? " view '$view'" : '';
    print "$what $id$where: $n path(s) touched\n";
    return $n;
}

sub cmd_write {
    my ($mode, @args) = @_;
    my %opts;
    GetOptionsFromArray(\@args,
        'data=s' => \$opts{data}, 'text=s' => \$opts{text}, 'file=s' => \$opts{file},
        'digest=s' => \$opts{digest}, 'dry-run' => \$opts{dry_run}, 'force' => \$opts{force},
        ($mode eq 'set' ? ('comments' => \$opts{comments}) : ()),
    ) or usage('bad options');
    my ($id, $view) = @args;
    usage("$mode needs an id") if !defined($id);
    usage('too many arguments') if @args > 2;
    my ($format, $text) = write_payload(\%opts);

    # No `call` wrapper inside the lock: a die unwinds through cfs_lock_domain
    # and `locked` reports it, where an exit would leave the callback mid-way.
    my $res = locked($id, sub {
        return PVE::RS::Meta::api_put(
            $id, $view, $format, $text, $mode eq 'merge' ? 'merge' : 'replace',
            $opts{digest}, ($opts{dry_run} ? 1 : 0), acl_for($id), ($opts{force} ? 1 : 0),
            ($opts{comments} ? 1 : 0),
        );
    });
    report_write($opts{dry_run} ? 'would write' : 'wrote', $id, $view, $res);
}

sub cmd_delete {
    my (@args) = @_;
    my %opts;
    GetOptionsFromArray(\@args, 'digest=s' => \$opts{digest}) or usage('bad options');
    my ($id, $view) = @args;
    usage('delete needs an id') if !defined($id);
    usage('too many arguments') if @args > 2;

    my $res = locked($id, sub {
        return PVE::RS::Meta::api_delete($id, $view, $opts{digest}, acl_for($id));
    });
    exit 2 if !report_write('removed', $id, $view, $res);
}

# A CLI wants the message and a status, not a stack trace.
sub call {
    my ($code) = @_;
    my $res = eval { $code->() };
    fail($@) if $@;
    return $res;
}

sub cmd_get {
    my (@args) = @_;
    my $format = 'yaml';
    my $comments = 0;
    GetOptionsFromArray(\@args, 'format=s' => \$format, 'comments' => \$comments)
        or usage('bad options');
    usage("unknown format '$format'") if $format !~ /^(yaml|json)$/;

    my ($id, $view) = @args;
    usage('get needs an id') if !defined($id);
    usage('too many arguments') if @args > 2;

    # Read as JSON first: it is the form that says whether the value has
    # structure, which decides how it should be printed.
    my $doc = eval { PVE::RS::Meta::api_get($id, $view, 'json', $ROOT_ACL, $comments) };
    if (my $err = $@) {
        # A document that does not parse is a 422 in JSON; as YAML with the
        # notes it is the raw file and its parse_error, as the API answers
        # format=yaml&comments=1 (docs/DESIGN.md §5).
        require PVE::API2::Ext::Meta;
        my ($status) = PVE::API2::Ext::Meta::parse_rs_error($err);
        fail($err) if ($status // 0) != 422 || $format ne 'yaml' || !$comments;
        my $raw = call(sub { PVE::RS::Meta::api_get($id, $view, 'yaml', $ROOT_ACL, 1) });
        print STDERR "$SELF: the stored document cannot be rendered: $raw->{parse_error}\n"
            if defined($raw->{parse_error});
        print $raw->{text};
        return;
    }
    my $data = $doc->{data};

    # A view the document does not have comes back as the empty document, same as
    # an empty map (docs/DESIGN.md §5); for a *view* that is what "not there" looks
    # like, so it is treated as absent.
    if (defined($view) && $view ne '' && ref($data) eq 'HASH' && !%$data) {
        exit 2;
    }
    # The whole document being empty means there is no document.
    if (!defined($view) && ref($data) eq 'HASH' && !%$data && $doc->{digest} eq '') {
        exit 2;
    }

    if ($format eq 'json') {
        # Canonical, i.e. keys sorted -- deliberately *not* the document's own key
        # order, which this hash could not carry anyway: perlmod renders a document
        # as a native Perl hash, and a Perl hash has no order (two reads of one
        # document can come back in two different orders). Sorted is at least
        # stable, which is what a script diffing this output needs. The default
        # `yaml` output below is the server's canonical text and does carry the
        # document's order.
        print JSON::PP->new->canonical->encode($data), "\n";
        return;
    }
    if (!ref($data)) {
        # A scalar prints as itself: no quotes, no `--- ` document marker, so
        # `$(pve-meta get ...)` is the value and nothing else.
        print defined($data) ? "$data\n" : "\n";
        return;
    }
    my $yaml = call(sub { PVE::RS::Meta::api_get($id, $view, 'yaml', $ROOT_ACL, $comments) });
    print $yaml->{text};
}

# The vmlist as a set, freshly refreshed: this process was just spawned, and an
# unrefreshed empty list reads as "every guest is gone" to anything that
# subtracts it.
sub live_vmids {
    require PVE::API2::Ext::Meta;
    my $ids = PVE::API2::Ext::Meta::vmlist_ids(1);
    return { map { int($_) => 1 } keys %$ids };
}

sub orphan_vmids {
    my $live = live_vmids();
    die "the vmlist is empty; refusing to call every document an orphan\n" if !%$live;
    my $stored = call(sub { PVE::RS::Meta::stored_vmids() });
    return grep { !$live->{$_} } @$stored;
}

sub cmd_ls {
    my (@args) = @_;
    my $format = 'plain';
    my $orphans = 0;
    GetOptionsFromArray(\@args, 'format=s' => \$format, 'orphans' => \$orphans)
        or usage('bad options');
    usage("unknown format '$format'") if $format !~ /^(plain|json)$/;
    usage('too many arguments') if @args;

    if ($orphans) {
        my @vmids = eval { orphan_vmids() };
        if (my $err = $@) {
            chomp $err;
            print STDERR "$SELF: $err\n";
            exit 1;
        }
        if ($format eq 'json') {
            print JSON::PP->new->canonical->encode(\@vmids), "\n";
        } else {
            print "$_\n" for @vmids;
        }
        exit 2 if !@vmids;
        return;
    }

    # The store's own walk (docs/DESIGN.md §6): every guest document, parses or
    # not, plus every prefix file, unscoped.
    my $vmids = call(sub { PVE::RS::Meta::stored_vmids() });
    my $prefixes = call(sub { PVE::RS::Meta::api_prefixes(undef, undef) });
    # A file the store cannot classify is listed too, flagged: it is nobody's
    # document, `rm` will not take it and `--orphans` will not name it, so this
    # is the only place a typo'd file name shows up.
    my $unknown = call(sub { PVE::RS::Meta::unknown_files() });
    my @docs = (
        (map { { id => "$_" } } sort { $a <=> $b } @$vmids),
        (map { { id => "prefixes/$_->{prefix}" } } @$prefixes),
        (map { { id => "unknown/$_", unknown => JSON::PP::true } } @$unknown),
    );
    if ($format eq 'json') {
        print JSON::PP->new->canonical->encode(\@docs), "\n";
        return;
    }
    print "$_->{id}\n" for @docs;
}

sub cmd_rm {
    my (@args) = @_;
    usage('rm needs a vmid') if !@args;
    usage('too many arguments') if @args > 1;
    my ($vmid) = @args;
    usage("'$vmid' is not a vmid") if $vmid !~ /^[1-9][0-9]*$/;
    $vmid = int($vmid);

    # The document's own write lock, with the vmlist re-read inside it: a guest
    # created at this vmid after the check outside the lock would otherwise have
    # its fresh document deleted, with its PUT long since answered 200.
    my $removed = with_lock($vmid, sub {
        my $live = live_vmids();
        die "the vmlist is empty; refusing to remove anything\n" if !%$live;
        die "$vmid is a live guest; remove its metadata through the API or the UI\n"
            if $live->{$vmid};
        return PVE::RS::Meta::on_destroy($vmid);
    });
    if (!$removed) {
        print STDERR "$SELF: nothing stored for $vmid\n";
        exit 2;
    }
    print "removed $removed file(s) for $vmid\n";
}

# Every guest in the cluster whose notes carry a backup block: import it where the
# store has no document for that vmid, strip it either way (docs/DESIGN.md §7,
# docs/LIFECYCLE.md's "Install"). Writes go to each guest's own node path, not
# through write_config, and take that guest's own-node lock only.
sub cmd_scan_notes {
    my (@args) = @_;
    usage('too many arguments') if @args;

    require PVE::Cluster;
    require PVE::API2::Ext::Meta;
    require PVE::INotify;
    require PVE::QemuConfig;
    require PVE::LXC::Config;

    my $local_node = PVE::INotify::nodename();
    PVE::Cluster::cfs_update();
    my $vmlist = PVE::Cluster::get_vmlist() || {};
    my $ids = $vmlist->{ids} // {};
    my %count = (imported => 0, stripped => 0, failed => 0);

    for my $vmid (sort { $a <=> $b } keys %$ids) {
        my ($type, $node) = @{ $ids->{$vmid} }{qw(type node)};
        my $class =
              $type eq 'qemu' ? 'PVE::QemuConfig'
            : $type eq 'lxc'  ? 'PVE::LXC::Config'
            :                   next;
        my $path = $class->cfs_config_path($vmid, $node);

        # The cheap look first, unlocked: nearly every guest has no block.
        my $conf = eval { PVE::Cluster::cfs_read_file($path) };
        next if !$conf || !defined($conf->{description});
        next if index($conf->{description}, '[pve-meta v') == -1;

        my $action = 'none';
        my $import = sub {
            $conf = PVE::Cluster::cfs_read_file($path);
            return if !$conf || !defined($conf->{description});
            return if index($conf->{description}, '[pve-meta v') == -1;
            my $res;
            PVE::Cluster::cfs_lock_domain(
                PVE::API2::Ext::Meta::lock_domain_for($vmid),
                $LOCK_TIMEOUT,
                sub {
                    $res = PVE::RS::Meta::notes_import(
                        $vmid, $conf->{description}, 'install',
                    );
                },
            );
            die $@ if $@;
            $action = $res->{action};
            return if !defined($res->{description});
            if (length($res->{description})) {
                $conf->{description} = $res->{description};
            } else {
                delete $conf->{description};
            }
            PVE::Cluster::cfs_write_file($path, $conf);
        };
        eval {
            if ($node eq $local_node) {
                $class->lock_config($vmid, $import);
            } else {
                $import->();
            }
        };
        if (my $err = $@) {
            my (undef, $msg) = PVE::API2::Ext::Meta::parse_rs_error($err);
            print STDERR "$SELF: $vmid: $msg\n";
            $count{failed}++;
            next;
        }
        next if $action eq 'none';
        print "$vmid: $action\n";
        $count{$action}++;
    }

    print "scan-notes: $count{imported} imported, $count{stripped} stripped, $count{failed} failed\n";
    exit 1 if $count{failed};
}

my $cmd = shift @ARGV;
usage() if !defined($cmd) || $cmd eq 'help' || $cmd eq '--help' || $cmd eq '-h';
if ($cmd eq 'get') {
    cmd_get(@ARGV);
} elsif ($cmd eq 'set' || $cmd eq 'merge') {
    cmd_write($cmd, @ARGV);
} elsif ($cmd eq 'delete') {
    cmd_delete(@ARGV);
} elsif ($cmd eq 'ls') {
    cmd_ls(@ARGV);
} elsif ($cmd eq 'rm') {
    cmd_rm(@ARGV);
} elsif ($cmd eq 'scan-notes') {
    cmd_scan_notes(@ARGV);
} else {
    usage("unknown command '$cmd'");
}
exit 0;
