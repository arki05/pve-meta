#!/usr/bin/make -f

include /usr/share/dpkg/pkg-info.mk

export DH_VERBOSE = 1

%:
	dh $@

override_dh_auto_build:
	$(MAKE) build ui

# Cargo.toml's `[workspace.package] version` must agree with debian/changelog's
# upstream version (see docs/design/PROXMOX-CONVENTIONS.md §7.4, mirroring
# upstream pve-rs's debian/rules): catches a bumped changelog with a forgotten
# Cargo.toml bump (or vice versa) at build time instead of shipping a `.deb`
# whose own crate disagrees with its own package version. Skipped for
# `UNRELEASED` (in-progress/dev) changelog entries, same as PDM's UI package.
override_dh_auto_configure:
ifneq ($(DEB_DISTRIBUTION),UNRELEASED)
	@perl -ne 'if (/^version\s*=\s*"(\d+(?:\.\d+)+)"/) { my $$v_cargo = $$1; my $$v_deb = "$(DEB_VERSION_UPSTREAM)"; \
	    die "ERROR: d/changelog <-> Cargo.toml version mismatch: $$v_cargo != $$v_deb\n" if $$v_cargo ne $$v_deb; exit(0); }' Cargo.toml
endif
	dh_auto_configure

# Two binary packages from this one source (see debian/control):
#   - `pve-meta`:            top-level Makefile's `install` target
#   - `libpve-meta-rs-perl`: crates/pve-meta-perl's own Makefile, its own DESTDIR
#     (see crates/pve-meta-perl/PACKAGING.md, option 1) so its files never land in
#     the other package's tree.
override_dh_auto_install:
	$(MAKE) install DESTDIR=$(CURDIR)/debian/pve-meta PREFIX=/usr
	$(MAKE) -C crates/pve-meta-perl install DESTDIR=$(CURDIR)/debian/libpve-meta-rs-perl

override_dh_auto_test:
	# Rust tests run separately on the build host (cargo test -p pve-meta-core);
	# skipped here since the packaging build runs with -d and no guaranteed
	# network access for crates.io during a plain `dpkg-buildpackage`.

# GC timer (docs/DESIGN.md section 6, README.md): dh_installsystemd's
# default (no --name) only looks for debian/pve-meta.{service,timer} --
# a *second*, differently-named unit pair for the same package needs an
# explicit --name so it looks for debian/pve-meta.pve-meta-gc.{service,timer}
# instead and installs/enables them as pve-meta-gc.{service,timer} (see
# dh_installsystemd(1), "--name"). Default behavior otherwise (timer
# enabled+started, service only enabled) is what we want.
override_dh_installsystemd:
	dh_installsystemd --name=pve-meta-gc
