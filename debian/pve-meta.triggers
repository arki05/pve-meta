# Guest-lifecycle managed patch (see patches/lifecycle.toml, patches/lifecycle/,
# applied via pve-ext-patch): re-run whenever one of the packages reships a
# file it patches, so the patch survives their upgrades. postinst calls
# pve-ext-patch tolerantly (no-op if it, or a target file, is absent).
#
# Note: index.html.tpl and PVE/API2.pm are not this package's concern --
# pve-ext owns those triggers (see pve-ext/debian/triggers).
interest-noawait /usr/share/perl5/PVE/AbstractConfig.pm
interest-noawait /usr/share/perl5/PVE/VZDump/QemuServer.pm
interest-noawait /usr/share/perl5/PVE/VZDump/LXC.pm
