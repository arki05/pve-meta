# Guest-lifecycle-hook managed patch (see patches/lifecycle.toml,
# patches/lifecycle/, applied via pve-ext-patch): re-run whenever any of
# these packages reship the files it patches, so the patch survives their
# upgrades. postinst calls pve-ext-patch tolerantly (no-op if it, or a
# target file, is absent).
#
# Note: index.html.tpl and PVE/API2.pm are no longer this package's
# concern -- pve-ext owns those triggers now (see pve-ext/debian/triggers).
interest-noawait /usr/share/perl5/PVE/AbstractConfig.pm
interest-noawait /usr/share/perl5/PVE/API2/LXC.pm
interest-noawait /usr/share/perl5/PVE/LXC/Create.pm
interest-noawait /usr/share/perl5/PVE/VZDump/LXC.pm
interest-noawait /usr/share/perl5/PVE/API2/Qemu.pm
interest-noawait /usr/share/perl5/PVE/QemuServer.pm
interest-noawait /usr/share/perl5/PVE/VZDump/QemuServer.pm
