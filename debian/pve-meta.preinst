#!/bin/sh
# preinst for the pve-meta package.
#
# Nothing to do here today: this is pve-meta's first release (see
# debian/changelog), so there is no prior pve-meta-owned diversion to
# migrate away from -- pve-meta has always depended on pve-ext and let
# pve-ext-patch own its diversions (see debian/pve-meta.postinst,
# pve-ext/README.md).
#
# If a future pve-meta release ever needs to migrate off a diversion
# scheme of its own (the way this comment used to describe, before this
# package's model settled on pve-ext-patch from day one), that one-time
# transition belongs here, in preinst's `upgrade` case, and must run
# *before* dpkg replaces the old binaries capable of undoing it -- by the
# time this package's own postinst runs, dpkg has already unpacked the
# new version's files, so anything needed to unwind old state must happen
# earlier than that.
set -e

#DEBHELPER#

exit 0
