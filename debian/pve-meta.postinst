#!/bin/sh
# postinst for the pve-meta package: applies the guest-lifecycle managed
# patch (patches/lifecycle.toml) via pve-ext-patch, and runs the one-time
# notes scan. Never allowed to fail the package install/configure.
set -e

# /etc/pve/local only exists once pmxcfs is actually mounted, the same guard
# PVE's own packages use before writing under /etc/pve.
ensure_dropdirs() {
    if [ -d /etc/pve/local ]; then
        mkdir -p /etc/pve/meta.d/prefixes || {
            echo "pve-meta: warning: could not create /etc/pve/meta.d/prefixes." >&2
        }
    fi
}

apply_lifecycle_patch() {
    if command -v pve-ext-patch >/dev/null 2>&1; then
        pve-ext-patch apply pve-meta-lifecycle || {
            echo "pve-meta: warning: pve-ext-patch apply pve-meta-lifecycle failed, see above." >&2
        }
    else
        echo "pve-meta: warning: pve-ext-patch not found on PATH (is pve-ext installed?)." >&2
    fi
}

# Reads every backup notes block left in the cluster's guest configs back
# into the store and strips it (docs/LIFECYCLE.md's "Install"). Idempotent,
# cluster-wide, and safe to run again by hand.
scan_notes() {
    if [ -d /etc/pve/local ] && command -v pve-meta >/dev/null 2>&1; then
        pve-meta scan-notes || {
            echo "pve-meta: warning: 'pve-meta scan-notes' did not finish cleanly, see above; run it again by hand." >&2
        }
    fi
}

# Since 0.2.0 permission files and per-node prefix directories are ignored
# (docs/DESIGN.md, decisions 024/025). Say so loudly on upgrade instead of
# silently dropping what an operator thought was enforced.
warn_ignored_legacy() {
    if [ -d /etc/pve/local ]; then
        if [ -d /etc/pve/meta.d/permissions ] && [ -n "$(ls -A /etc/pve/meta.d/permissions 2>/dev/null)" ]; then
            echo "pve-meta: warning: /etc/pve/meta.d/permissions/ still holds files, ignored since 0.2.0 (access is PVE ACLs now); remove the directory." >&2
        fi
        for d in /etc/pve/nodes/*/meta.d/prefixes; do
            if [ -d "$d" ] && [ -n "$(ls -A "$d" 2>/dev/null)" ]; then
                echo "pve-meta: warning: $d still holds files, ignored since 0.2.0; fold them into /etc/pve/meta.d/prefixes/<name>.yaml as a nodes: override." >&2
            fi
        done
    fi
}

# Restarts pvedaemon/pveproxy to pick up the lifecycle patch; a no-op off a
# systemd host and never fails the install.
restart_pve_services() {
    if command -v deb-systemd-invoke >/dev/null 2>&1; then
        deb-systemd-invoke reload-or-try-restart pvedaemon.service pveproxy.service || {
            echo "pve-meta: warning: could not restart pvedaemon/pveproxy; restart them manually to pick up the pve-meta lifecycle patch." >&2
        }
    fi
}

case "$1" in
    configure)
        ensure_dropdirs
        warn_ignored_legacy
        apply_lifecycle_patch
        restart_pve_services
        scan_notes
        ;;
    triggered)
        # $2 is the whitespace-separated list of trigger names that fired
        # (see debian/pve-meta.triggers); re-applying is enough either way.
        apply_lifecycle_patch
        restart_pve_services
        ;;
    abort-upgrade | abort-remove | abort-deconfigure) ;;
    *) ;;
esac

#DEBHELPER#

exit 0
