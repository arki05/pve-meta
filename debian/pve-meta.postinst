#!/bin/sh
# postinst for the pve-meta package.
#
# pve-meta is a consumer of pve-ext's generic extension layer (see
# docs/DESIGN.md section 5, pve-ext/README.md): its UI tab is a page
# manifest (pages/pve-meta.json) pve-ext-loader.js discovers on its own,
# and its API module (perl/PVE/API2/Ext/Meta.pm) is discovered by
# PVE::API2::Ext at pvedaemon/pveproxy startup -- neither needs anything
# from this script. The one thing this package still applies itself is
# its guest-lifecycle managed-patch manifest (see patches/lifecycle.toml),
# via pve-ext's own `pve-ext-patch` tool.
#
# Re-running `pve-ext-patch apply` is safe and idempotent. Never allowed
# to fail the package install/configure -- `pve-ext-patch verify`/`status`
# exist to diagnose problems afterwards.
set -e

PVE_EXT_PATCH=/usr/sbin/pve-ext-patch

apply_lifecycle_patch() {
    if [ -x "$PVE_EXT_PATCH" ]; then
        "$PVE_EXT_PATCH" apply pve-meta-lifecycle || {
            echo "pve-meta: warning: pve-ext-patch apply pve-meta-lifecycle failed, see above." >&2
        }
    else
        echo "pve-meta: warning: $PVE_EXT_PATCH not found or not executable (is pve-ext installed?)." >&2
    fi
}

# The lifecycle patch changes files pvedaemon has already loaded into
# memory, so restart both PVE daemons to pick the change up.
# `deb-systemd-invoke reload-or-try-restart` (not a raw `systemctl
# restart`) goes through each unit's own `ExecReload` when it has one --
# pveproxy's is `/usr/bin/pveproxy restart`, PVE's own graceful in-place
# respawn that does not drop in-flight connections the way a hard
# stop/start does -- and also respects policy-rc.d (chroots/containers
# that disable service management). Best-effort only: never fails the
# package install/configure, and is a harmless no-op off a systemd host
# (e.g. inside some build/test environments).
restart_pve_services() {
    if command -v deb-systemd-invoke >/dev/null 2>&1; then
        deb-systemd-invoke reload-or-try-restart pvedaemon.service pveproxy.service || {
            echo "pve-meta: warning: could not restart pvedaemon/pveproxy; restart them manually to pick up the pve-meta lifecycle patch." >&2
        }
    fi
}

case "$1" in
    configure)
        apply_lifecycle_patch
        restart_pve_services
        ;;
    triggered)
        # $2 is the whitespace-separated list of trigger names that fired
        # (see debian/pve-meta.triggers); re-applying is enough either way.
        apply_lifecycle_patch
        restart_pve_services
        ;;
    abort-upgrade | abort-remove | abort-deconfigure) ;;
    *) ;;
esac

#DEBHELPER#

exit 0
