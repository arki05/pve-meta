#!/bin/sh
# prerm for the pve-meta package: reverses the lifecycle managed patch on
# `remove`, before dpkg deletes this package's own files. A no-op on
# `upgrade`: the new version's postinst re-applies idempotently.
#
# Never spell out the debhelper-substitution placeholder text anywhere in
# this file except its own line below: dh_installdeb's substitution is a
# blind string replace, so a second occurrence gets replaced too and
# corrupts the script.
set -e

case "$1" in
    remove)
        if command -v pve-ext-patch >/dev/null 2>&1; then
            pve-ext-patch remove pve-meta-lifecycle || {
                echo "pve-meta: warning: pve-ext-patch remove pve-meta-lifecycle failed, its patch may still be active." >&2
            }
        fi
        ;;
    upgrade | deconfigure | failed-upgrade) ;;
    *) ;;
esac

#DEBHELPER#

exit 0
