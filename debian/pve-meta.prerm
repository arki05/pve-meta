#!/bin/sh
# prerm for the pve-meta package.
#
# Reverses both local patches *before* dpkg removes this package's own
# files -- per Debian policy, `prerm remove` runs before the package's
# files are deleted, while `postrm remove` runs after, by which point
# /usr/sbin/pve-meta-patch (etc.) would already be gone and unable to run
# its own `dpkg-divert --remove` cleanup. On `upgrade` we deliberately do
# nothing: the new version's postinst re-applies (idempotently) once it's
# configured, so there is no need (and no benefit) to unpatch in between.
set -e

remove_patch() {
    tool="$1"
    if [ -x "$tool" ]; then
        "$tool" remove || {
            echo "pve-meta: warning: $tool remove failed, its patch may still be active." >&2
        }
    fi
}

case "$1" in
    remove)
        remove_patch /usr/sbin/pve-meta-patch
        remove_patch /usr/sbin/pve-meta-lifecycle-patch
        ;;
    upgrade|deconfigure|failed-upgrade)
        ;;
    *)
        ;;
esac

#DEBHELPER#

exit 0
