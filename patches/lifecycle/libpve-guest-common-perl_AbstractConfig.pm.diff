+                "pve-meta-$vmid", 10, sub { PVE::RS::Meta::on_create($vmid) },
+            );
+            $meta_err = $@;
+        };
+        $meta_err = $@ if !$meta_err;
+        warn "pve-meta: on_create($vmid) failed: $meta_err" if $meta_err;
+    }
 }
 
