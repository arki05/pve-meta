 sub write_config {
     my ($class, $vmid, $conf) = @_;
 
+    # pve-meta: a config restored from a backup carries the guest's metadata document
+    # in its notes, appended there by the patched vzdump assemble (docs/LIFECYCLE.md).
+    # Every restore path ends in this write, so this is where the document goes back
+    # into /etc/pve/meta and the block leaves the notes -- but only while the marker
+    # create_and_lock_config left for the vmid is there: this cannot tell a restore
+    # from a `qm set`, the marker can. A create or restore keeps the config locked
+    # until it is done and writes it several times on the way (pve-container writes a
+    # bare `lock: create` skeleton mid-restore), so the marker is taken by the first
+    # write that carries a block, or by the first write of an unlocked config, and by
+    # nothing in between. A create that carried no block ends with an unlocked write,
+    # so it leaves nothing behind for a later paste to use.
+    # The import runs under the document's own lock, the one every other writer takes,
+    # inside the guest lock the caller holds, the same order create and destroy use.
+    # An error leaves the notes as they are, block included, and never fails the write.
+    my $meta_block = defined($conf->{description})
+        && index($conf->{description}, '[pve-meta v') != -1;
+    my $meta_created;
+    if ($meta_block || !$conf->{lock}) {
+        $meta_created = eval { PVE::RS::Meta::take_created($vmid) };
+        warn "pve-meta: take_created($vmid) failed: $@" if $@;
+    }
+    if ($meta_created && $meta_block) {
+        my $meta_err;
+        eval {
+            PVE::Cluster::cfs_lock_domain(
+                "pve-meta-$vmid",
+                10,
+                sub {
+                    my $res = PVE::RS::Meta::notes_import($vmid, $conf->{description}, 'restore');
+                    return if !defined($res->{description});
+                    if (length($res->{description})) {
+                        $conf->{description} = $res->{description};
+                    } else {
+                        delete $conf->{description};
+                    }
+                },
+            );
+            $meta_err = $@;
+        };
+        $meta_err = $@ if !$meta_err;
+        warn "pve-meta: notes_import($vmid) failed: $meta_err" if $meta_err;
+    }
+
     my $cfspath = $class->cfs_config_path($vmid);
 
     PVE::Cluster::cfs_write_file($cfspath, $conf);
