+    # pve-meta: a genuinely new guest starts with no inherited metadata. Only when
+    # $allow_existing is false, i.e. when check_vmid_unused() above has just asserted
+    # this vmid was free -- a restore *over* an existing guest keeps its document here;
+    # the restore then replaces it from the backup's notes block (write_config below),
+    # or leaves it if the backup carried none.
+    if (!$allow_existing) {
+        # pve-meta: under the document's own lock -- the one every other writer
+        # takes (`PVE::API2::Ext::Meta::_locked`, `pve-meta rm`). Without it the
+        # hook races an in-flight write: the write passes its checks, this purge
+        # runs, the vmid is reused, and the stalled write lands on the new guest's
+        # slot carrying the old guest's metadata. That is the vmid-reuse window
+        # these hooks exist to close, so they have to close it against writers too.
+        #
+        # `cfs_lock_domain` reports the callback's die through `$@` rather than
+        # raising, so `$@` is read inside the eval, before leaving it clears it.
+        # The eval is for `cfs_lock_domain` itself: cleaning up metadata must never
+        # be able to fail a guest create or destroy.
+        my $meta_err;
+        eval {
