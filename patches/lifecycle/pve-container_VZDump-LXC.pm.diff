--- a/usr/share/perl5/PVE/VZDump/LXC.pm
+++ b/usr/share/perl5/PVE/VZDump/LXC.pm
@@ -13,6 +13,7 @@
 use PVE::LXC::Config;
 use PVE::LXC::Namespaces;
 use PVE::LXC;
+use PVE::RS::Meta;
 use PVE::Storage;
 use PVE::Tools;
 use PVE::VZDump;
@@ -333,6 +334,23 @@
     delete $conf->{parent};
     delete $conf->{pending};
 
+    # pve-meta: carry the guest's metadata document in this copy of the notes, as one
+    # marked block after whatever notes the guest has (docs/LIFECYCLE.md). Only this
+    # copy: $conf is a fresh load, and the live config never carries it. A restore on a
+    # host with pve-meta reads it back into /etc/pve/meta and strips it; any other host
+    # restores it as notes text. A document that cannot be carried (above the size
+    # cap, or not parseable) is a warning in this log, not a failure.
+    my $meta_block = eval { PVE::RS::Meta::export_for_backup($vmid) };
+    if (my $err = $@) {
+        chomp $err;
+        $self->log('warn', "pve-meta: metadata of $vmid not included in the backup: $err");
+    } elsif (defined($meta_block)) {
+        my $notes = $conf->{description} // '';
+        $notes =~ s/\s+$//;
+        $conf->{description} = (length($notes) ? "$notes\n\n" : '') . $meta_block;
+        $self->loginfo("pve-meta: metadata of $vmid included in the backup notes");
+    }
+
     my $tmpdir = $task->{tmpdir};
 
     mkpath "$tmpdir/etc/vzdump/";
