#!/bin/bash
#
# pve-ext-patch - apply/remove/verify/status for pve-ext's managed-patch
# seam: dpkg-divert a stock PVE file, rebuild it from the pristine backup
# plus a manifest's diff, gate on a syntax/template check, then install.
# See pve-ext/README.md ("Managed patches") for the manifest format and
# the full picture; this header stays short per CONTRIBUTING.md.
set -u

PKG="pve-ext"
CANON_MANIFEST_DIR="/usr/share/pve-ext/patches"

ROOT_DIR=""
SCRATCH_ROOT=""

log() { echo "pve-ext-patch: $*"; }
warn() { echo "pve-ext-patch: WARNING: $*" >&2; }
err() { echo "pve-ext-patch: ERROR: $*" >&2; }
die() {
    err "$*"
    exit 1
}

script_dir() {
    cd "$(dirname "${BASH_SOURCE[0]}")" >/dev/null 2>&1 && pwd
}

require_cmd() {
    command -v "$1" >/dev/null 2>&1 || die "required command '$1' not found"
}

cleanup_scratch() {
    [ -n "$SCRATCH_ROOT" ] && [ -d "$SCRATCH_ROOT" ] && rm -rf -- "$SCRATCH_ROOT"
}

# --- manifest directory / resolution -----------------------------------

# Canonical packaged location (under --root), else ../patches next to this
# script (checkout / ad-hoc use).
manifest_dir() {
    local canon="${ROOT_DIR}${CANON_MANIFEST_DIR}"
    if [ -d "$canon" ]; then
        echo "$canon"
        return 0
    fi
    local checkout
    checkout="$(script_dir)/../patches"
    if [ -d "$checkout" ]; then
        echo "$checkout"
        return 0
    fi
    return 1
}

# Resolves one manifest argument (a bare name, or a path to a .json file)
# to an absolute manifest file path. Echoes it, or returns non-zero.
resolve_manifest() {
    local arg="$1" dir
    case "$arg" in
        */* | *.json)
            if [ -f "$arg" ]; then
                echo "$arg"
                return 0
            fi
            return 1
            ;;
        *)
            dir="$(manifest_dir)" || return 1
            if [ -f "${dir}/${arg}.json" ]; then
                echo "${dir}/${arg}.json"
                return 0
            fi
            return 1
            ;;
    esac
}

# Populates the global array MANIFESTS: the given names/paths, or (with
# none given) every *.json in the manifest directory.
select_manifests() {
    MANIFESTS=()
    if [ "$#" -eq 0 ]; then
        local dir manifest
        dir="$(manifest_dir)" || die "no manifest directory found (looked for ${ROOT_DIR}${CANON_MANIFEST_DIR} and next to this script) and no manifest named on the command line"
        for manifest in "$dir"/*.json; do
            [ -f "$manifest" ] && MANIFESTS+=("$manifest")
        done
        [ "${#MANIFESTS[@]}" -gt 0 ] || die "no *.json manifests found in $dir"
        return 0
    fi
    local arg resolved
    for arg in "$@"; do
        resolved="$(resolve_manifest "$arg")" || die "no such manifest: '$arg' (looked for it as a path, and as <name>.json under the manifest directory)"
        MANIFESTS+=("$resolved")
    done
}

# --- manifest reader ----------------------------------------------------

# Emits one line per entry of $1's "files" array, fields separated by 0x1f:
# path\x1fpackage\x1fdiff\x1fmarker\x1fcheck ("check" defaults to "perl").
# A manifest is JSON, read with core Perl's JSON::PP; one that does not
# parse, or has no "files" array of objects, is an error and emits nothing.
# main reads every selected manifest once before any command runs, so such
# an error stops the command before it touches a file: the loops below read
# parse_manifest through a process substitution, which drops its status.
parse_manifest() {
    perl -MJSON::PP -e '
        my $file = $ARGV[0];
        my $m = eval {
            open(my $fh, "<", $file) or die "$!\n";
            local $/;
            JSON::PP->new->decode(<$fh>);
        };
        die "pve-ext-patch: ERROR: manifest $file: $@" if $@;
        die "pve-ext-patch: ERROR: manifest $file: no \"files\" array of objects\n"
            if ref($m) ne "HASH" || ref($m->{files}) ne "ARRAY"
            || grep { ref($_) ne "HASH" } @{ $m->{files} };
        for my $f (@{ $m->{files} }) {
            print join("\x1f", map { $_ // "" } @$f{qw(path package diff marker)}),
                "\x1f", $f->{check} // "perl", "\n";
        }
    ' "$1"
}

# --- dpkg-divert helpers (honor --root) --------------------------------

set_dpkg_root_args() {
    DPKG_ROOT_ARGS=()
    if [ -n "$ROOT_DIR" ]; then
        DPKG_ROOT_ARGS=(--root "$ROOT_DIR")
    fi
}

# $1 is always the manifest's own (unprefixed) path: dpkg-divert's --root
# already prepends ROOT_DIR itself.
divert_arg_diverted() { echo "$1.pve-ext-orig"; }

is_diverted() {
    local -a DPKG_ROOT_ARGS=()
    set_dpkg_root_args
    dpkg-divert "${DPKG_ROOT_ARGS[@]}" --truename "$1" 2>/dev/null | grep -qx "$(divert_arg_diverted "$1")"
}

diversion_owned_by_us() {
    local -a DPKG_ROOT_ARGS=()
    set_dpkg_root_args
    dpkg-divert "${DPKG_ROOT_ARGS[@]}" --listpackage "$1" 2>/dev/null | grep -qx "$PKG"
}

dpkg_divert_add() {
    local -a DPKG_ROOT_ARGS=()
    set_dpkg_root_args
    dpkg-divert "${DPKG_ROOT_ARGS[@]}" --package "$PKG" --add --rename --divert "$(divert_arg_diverted "$1")" "$1"
}

dpkg_divert_remove() {
    local -a DPKG_ROOT_ARGS=()
    set_dpkg_root_args
    dpkg-divert "${DPKG_ROOT_ARGS[@]}" --package "$PKG" --remove --rename --divert "$(divert_arg_diverted "$1")" "$1"
}

# Canonicalizes a directory before a scratch-dir `cd` changes the caller's
# relative-path assumptions.
abs_dir() { (cd "$1" 2>/dev/null && pwd) || echo "$1"; }

real_path_for() { echo "${ROOT_DIR}$1"; }
diverted_path_for() { echo "$(real_path_for "$1").pve-ext-orig"; }
# Real path minus its leading '/', matching what `patch -p1` reconstructs
# from a diff's a/ b/ headers.
relpath_for() { echo "${1#/}"; }

# Rebuilds pristine + diff as <work>/<rel>, a scratch copy at the path
# `patch -p1` reconstructs, never the file itself. Prints patch's output
# and fails with patch's status if a hunk does. A copy that fails is its
# own error, and status 3, which patch never returns: no hunk was tried.
# --fuzz=0: default fuzz can slide a hunk onto the wrong one of several
# near-identical anchors and report success.
patch_into_scratch() {
    # $1 = pristine, $2 = work dir, $3 = rel, $4 = diff path
    if ! mkdir -p "$(dirname "$2/$3")" || ! cp "$1" "$2/$3"; then
        err "could not copy $1 into the scratch area"
        return 3
    fi
    (cd "$2" && patch -p1 --fuzz=0 <"$4" 2>&1)
}

# --- failure rollback ----------------------------------------------------

# On failure: undo a diversion this run just created (restores $real
# exactly as found); otherwise restore the *current* pristine over $real,
# so a re-apply failure after an upstream package upgrade never leaves
# stale patched content in place.
restore_on_failure() {
    # $1 = mpath, $2 = real, $3 = diverted, $4 = created_divert (0|1)
    local mpath="$1" real="$2" diverted="$3" created_divert="$4"
    if [ "$created_divert" -eq 1 ]; then
        log "$mpath: rolling back diversion created moments ago"
        # dpkg-divert --remove --rename refuses to rename the pristine
        # backup back onto $real while $real still holds a regular file.
        rm -f "$real"
        if ! dpkg_divert_remove "$mpath" >/dev/null 2>&1; then
            err "$mpath: FAILED to roll back the diversion just created - dpkg-divert --remove failed; the diversion is still in dpkg's database (owned by ${PKG}) and $real is now missing"
        fi
        return
    fi
    if [ -f "$diverted" ]; then
        if cp -a "$diverted" "$real" 2>/dev/null; then
            err "$mpath: restored current pristine (unpatched) content to $real so the node stays consistent"
        else
            err "$mpath: FAILED to restore pristine to $real - it may still hold stale patched content from before this failure!"
        fi
    fi
}

# --- perl -c gate --------------------------------------------------------

perl_check_ok() {
    local file="$1"
    local out last
    out="$(perl -I "${ROOT_DIR}/usr/share/perl5" -c "$file" 2>&1)"
    last="$(printf '%s\n' "$out" | tail -n1)"
    LAST_PERL_CHECK_OUTPUT="$out"
    LAST_PERL_CHECK_VERDICT="$last"
    printf '%s' "$last" | grep -Eq 'syntax OK$'
}

# --- template gate ---------------------------------------------------

template_check_ok() {
    # $1 = file, $2 = marker (the exact tag expected exactly once)
    local file="$1" marker="$2" count
    count=$(grep -cF -- "$marker" "$file")
    if [ "$count" -ne 1 ]; then
        LAST_TEMPLATE_CHECK_VERDICT="marker appears $count time(s) (expected 1)"
        return 1
    fi
    if ! grep -qF -- '</body>' "$file"; then
        LAST_TEMPLATE_CHECK_VERDICT="</body> missing - rendered file looks malformed"
        return 1
    fi
    LAST_TEMPLATE_CHECK_VERDICT="marker present exactly once, </body> present"
    return 0
}

run_check() {
    # $1 = check type, $2 = file, $3 = marker
    case "$1" in
        perl)
            perl_check_ok "$2"
            ;;
        template)
            template_check_ok "$2" "$3"
            ;;
        *)
            err "unknown check type '$1' (must be 'perl' or 'template')"
            return 1
            ;;
    esac
}

check_verdict() {
    case "$1" in
        perl) echo "$LAST_PERL_CHECK_VERDICT" ;;
        template) echo "$LAST_TEMPLATE_CHECK_VERDICT" ;;
        *) echo "n/a" ;;
    esac
}

# --- apply --------------------------------------------------------------

apply_one() {
    # $1 = manifest dir (diffs are relative to this), $2 = path, $3 = package,
    # $4 = diff basename, $5 = marker, $6 = check
    local mdir="$1" mpath="$2" mpkg="$3" mdiff="$4" marker="$5" check="$6"
    local real diverted diff_path work rel created_divert=0

    real="$(real_path_for "$mpath")"
    diverted="$(diverted_path_for "$mpath")"
    diff_path="${mdir}/${mdiff}"
    rel="$(relpath_for "$mpath")"
    work="${SCRATCH_ROOT}/$(echo "$mpath" | tr '/' '_')"

    [ -f "$diff_path" ] || {
        err "$mpath: diff not found: $diff_path"
        return 1
    }

    if is_diverted "$mpath"; then
        if ! diversion_owned_by_us "$mpath"; then
            err "$mpath: diverted by a DIFFERENT package - refusing to touch it"
            return 1
        fi
        log "$mpath: diversion already in place (owned by ${PKG}); reusing pristine copy at $diverted"
    else
        [ -f "$real" ] || {
            err "$mpath: expected file not found: $real (owning package: ${mpkg:-unknown})"
            return 1
        }
        log "$mpath: diverting $real -> $diverted"
        if ! dpkg_divert_add "$mpath"; then
            err "$mpath: dpkg-divert --add failed"
            return 1
        fi
        created_divert=1
    fi

    if [ ! -f "$diverted" ]; then
        err "$mpath: pristine backup not found at $diverted after diversion - aborting this file"
        restore_on_failure "$mpath" "$real" "$diverted" "$created_divert"
        return 1
    fi

    # Restore the pristine placeholder for the duration of the check: a
    # fresh divert moves $real away, and other code mid-run may `require`
    # it; `install` below replaces it with the patched content once
    # validated.
    if [ ! -f "$real" ]; then
        if ! cp "$diverted" "$real"; then
            err "$mpath: failed to restore pristine placeholder at $real for the duration of the check"
            restore_on_failure "$mpath" "$real" "$diverted" "$created_divert"
            return 1
        fi
    fi

    local patch_out prc=0
    patch_out="$(patch_into_scratch "$diverted" "$work" "$rel" "$diff_path")" || prc=$?
    if [ "$prc" -ne 0 ]; then
        if [ "$prc" -ne 3 ]; then
            err "$mpath: the diff does not apply to the pristine copy - anchors may have moved upstream"
            printf '%s\n' "$patch_out" >&2
        fi
        restore_on_failure "$mpath" "$real" "$diverted" "$created_divert"
        return 1
    fi

    if ! run_check "$check" "${work}/${rel}" "$marker"; then
        err "$mpath: '$check' check failed: $(check_verdict "$check")"
        [ "$check" = "perl" ] && printf '%s\n' "$LAST_PERL_CHECK_OUTPUT" >&2
        restore_on_failure "$mpath" "$real" "$diverted" "$created_divert"
        return 1
    fi
    log "$mpath: $check check OK ($(check_verdict "$check"))"

    if ! install -m 0644 "${work}/${rel}" "$real"; then
        err "$mpath: failed to install patched file to $real"
        return 1
    fi
    log "$mpath: patched and installed."
    return 0
}

cmd_apply() {
    require_cmd dpkg-divert patch perl
    [ "$(id -u)" -eq 0 ] || [ -n "$ROOT_DIR" ] || die "apply must be run as root (or with --root for a non-live tree)"

    SCRATCH_ROOT="$(mktemp -d)" || die "mktemp -d failed"
    trap cleanup_scratch EXIT

    local manifest mdir rc=0 count=0
    for manifest in "${MANIFESTS[@]}"; do
        mdir="$(abs_dir "$(dirname "$manifest")")"
        log "manifest: $manifest"
        while IFS=$'\x1f' read -r mpath mpkg mdiff marker check; do
            [ -n "$mpath" ] || continue
            count=$((count + 1))
            apply_one "$mdir" "$mpath" "$mpkg" "$mdiff" "$marker" "$check" || rc=1
        done < <(parse_manifest "$manifest")
    done

    [ "$count" -gt 0 ] || die "no \"files\" entries found in the selected manifest(s)"

    echo
    cmd_status
    if [ "$rc" -eq 0 ]; then
        log "apply: success (${count} file(s), ${#MANIFESTS[@]} manifest(s))."
    else
        err "apply: one or more files failed - see above. Files that failed were left untouched (or reverted if just diverted); files that succeeded are installed."
    fi
    return "$rc"
}

# --- remove ---------------------------------------------------------

remove_one() {
    # $1 = path
    local mpath="$1"
    local real diverted
    real="$(real_path_for "$mpath")"
    diverted="$(diverted_path_for "$mpath")"

    if is_diverted "$mpath"; then
        if ! diversion_owned_by_us "$mpath"; then
            err "$mpath: diverted by a DIFFERENT package - refusing to remove"
            return 1
        fi
        log "$mpath: restoring pristine file and removing diversion"
        # dpkg-divert --remove --rename refuses to rename the pristine
        # backup onto $real while $real already holds a regular file.
        rm -f "$real"
        if ! dpkg_divert_remove "$mpath"; then
            err "$mpath: dpkg-divert --remove failed"
            if [ -f "$diverted" ] && [ ! -f "$real" ]; then
                err "$mpath: recovering: restoring from $diverted manually"
                cp -a "$diverted" "$real"
            fi
            return 1
        fi
    else
        log "$mpath: no diversion in place - nothing to restore"
    fi
    return 0
}

cmd_remove() {
    require_cmd dpkg-divert
    [ "$(id -u)" -eq 0 ] || [ -n "$ROOT_DIR" ] || die "remove must be run as root (or with --root for a non-live tree)"

    local manifest rc=0 count=0
    for manifest in "${MANIFESTS[@]}"; do
        log "manifest: $manifest"
        while IFS=$'\x1f' read -r mpath mpkg mdiff marker check; do
            [ -n "$mpath" ] || continue
            count=$((count + 1))
            remove_one "$mpath" || rc=1
        done < <(parse_manifest "$manifest")
    done

    echo
    cmd_status || true
    if [ "$rc" -eq 0 ]; then
        log "remove: success (${count} file(s), ${#MANIFESTS[@]} manifest(s))."
    else
        err "remove: one or more files failed - see above."
    fi
    return "$rc"
}

# --- verify ---------------------------------------------------------

verify_one() {
    # $1 = manifest dir, $2 = path, $3 = diff basename
    local mdir="$1" mpath="$2" mdiff="$3"
    local real diverted diff_path work rel pristine source_desc

    real="$(real_path_for "$mpath")"
    diverted="$(diverted_path_for "$mpath")"
    diff_path="${mdir}/${mdiff}"
    rel="$(relpath_for "$mpath")"
    work="${SCRATCH_ROOT}/$(echo "$mpath" | tr '/' '_').verify"

    [ -f "$diff_path" ] || {
        err "$mpath: diff not found: $diff_path"
        return 1
    }

    if is_diverted "$mpath" && [ -f "$diverted" ]; then
        pristine="$diverted"
        source_desc="diverted pristine backup"
    else
        pristine="$real"
        source_desc="live file (assumed pristine/unpatched)"
    fi
    [ -f "$pristine" ] || {
        err "$mpath: no pristine source found at $pristine"
        return 1
    }

    local patch_out rc total_hunks fail_hunks ok_hunks
    patch_out="$(patch_into_scratch "$pristine" "$work" "$rel" "$diff_path")"
    rc=$?
    [ "$rc" -ne 3 ] || return 1
    total_hunks=$(grep -c '^@@ ' "$diff_path")
    fail_hunks=$(printf '%s\n' "$patch_out" | grep -c '^Hunk #[0-9]* FAILED')
    if [ "$rc" -eq 0 ]; then
        ok_hunks="$total_hunks"
    else
        ok_hunks=$((total_hunks - fail_hunks))
    fi

    if [ "$rc" -eq 0 ]; then
        log "$mpath: OK - ${ok_hunks}/${total_hunks} hunks would apply cleanly against ${source_desc}"
        return 0
    else
        err "$mpath: FAIL - ${ok_hunks}/${total_hunks} hunks would apply, ${fail_hunks} failed, against ${source_desc}"
        printf '%s\n' "$patch_out" >&2
        return 1
    fi
}

cmd_verify() {
    require_cmd patch dpkg-divert

    SCRATCH_ROOT="$(mktemp -d)" || die "mktemp -d failed"
    trap cleanup_scratch EXIT

    local manifest mdir rc=0 count=0
    for manifest in "${MANIFESTS[@]}"; do
        mdir="$(abs_dir "$(dirname "$manifest")")"
        log "manifest: $manifest"
        while IFS=$'\x1f' read -r mpath mpkg mdiff marker check; do
            [ -n "$mpath" ] || continue
            count=$((count + 1))
            verify_one "$mdir" "$mpath" "$mdiff" || rc=1
        done < <(parse_manifest "$manifest")
    done

    if [ "$rc" -eq 0 ]; then
        log "verify: all selected files (${count}) would apply cleanly."
    else
        err "verify: one or more files would NOT apply cleanly - do not trust apply() without investigating."
    fi
    return "$rc"
}

# --- status ---------------------------------------------------------

status_one() {
    # $1 = path, $2 = manifest dir, $3 = diff basename, $4 = marker, $5 = check, $6 = package
    local mpath="$1" mdir="$2" mdiff="$3" marker="$4" check="$5" mpkg="$6"
    local real diverted diff_path
    real="$(real_path_for "$mpath")"
    diverted="$(diverted_path_for "$mpath")"
    diff_path="${mdir}/${mdiff}"

    local diverted_flag=0 owned_flag=0 pristine_flag=0 patched_flag=0 insync_flag=0 insync_checked=0

    is_diverted "$mpath" && diverted_flag=1
    if [ "$diverted_flag" -eq 1 ]; then
        diversion_owned_by_us "$mpath" && owned_flag=1
        [ -f "$diverted" ] && pristine_flag=1
    fi
    [ -f "$real" ] && grep -qF -- "$marker" "$real" && patched_flag=1

    # "In sync" rebuilds pristine+diff and compares to $real byte-for-byte
    # (never a reverse-apply against $real, which cannot detect a pristine
    # that moved on since $real was last patched).
    if [ "$diverted_flag" -eq 1 ] && [ "$pristine_flag" -eq 1 ] && [ -f "$real" ] \
        && [ -f "$diff_path" ] && [ -n "$SCRATCH_ROOT" ]; then
        local rel work
        rel="$(relpath_for "$mpath")"
        work="${SCRATCH_ROOT}/$(echo "$mpath" | tr '/' '_').status"
        if patch_into_scratch "$diverted" "$work" "$rel" "$diff_path" >/dev/null; then
            insync_checked=1
            cmp -s "${work}/${rel}" "$real" && insync_flag=1
        fi
    fi

    echo "  ${mpath} (package: ${mpkg:-unknown}, check: ${check}):"
    if [ "$diverted_flag" -eq 1 ]; then
        if [ "$owned_flag" -eq 1 ]; then
            echo "    diversion:       APPLIED (owned by ${PKG})"
        else
            echo "    diversion:       APPLIED (owned by a DIFFERENT package - unexpected!)"
        fi
        echo "    pristine backup: $([ "$pristine_flag" -eq 1 ] && echo "present ($diverted)" || echo "MISSING")"
    else
        echo "    diversion:       not applied"
    fi
    echo "    patched:         $([ "$patched_flag" -eq 1 ] && echo "yes (marker present in $real)" || echo "no")"
    if [ "$insync_checked" -eq 1 ]; then
        echo "    in sync w/ diff: $([ "$insync_flag" -eq 1 ] && echo "yes" || echo "no (live file does not exactly match diff's expected output)")"
    fi

    if [ "$diverted_flag" -eq 1 ] && [ "$owned_flag" -eq 1 ] && [ "$pristine_flag" -eq 1 ] && [ "$patched_flag" -eq 1 ]; then
        echo "    overall:         APPLIED"
        return 0
    else
        echo "    overall:         NOT APPLIED"
        return 1
    fi
}

cmd_status() {
    require_cmd dpkg-divert
    if [ -z "$SCRATCH_ROOT" ]; then
        SCRATCH_ROOT="$(mktemp -d)" || SCRATCH_ROOT=""
        [ -n "$SCRATCH_ROOT" ] && trap cleanup_scratch EXIT
    fi

    echo "pve-ext-patch status:"
    local manifest mdir rc=0
    for manifest in "${MANIFESTS[@]}"; do
        echo " manifest: $manifest"
        mdir="$(abs_dir "$(dirname "$manifest")")"
        while IFS=$'\x1f' read -r mpath mpkg mdiff marker check; do
            [ -n "$mpath" ] || continue
            status_one "$mpath" "$mdir" "$mdiff" "$marker" "$check" "$mpkg" || rc=1
        done < <(parse_manifest "$manifest")
    done
    return "$rc"
}

# --- usage / main -----------------------------------------------------

usage() {
    cat <<EOF
Usage: $(basename "$0") [--root <dir>] <apply|remove|verify|status> [manifest...]

  apply [manifest...]   Divert each entry's file (if not already), apply its
                        diff (patch -p1 --fuzz=0) into a scratch copy, gate
                        on every hunk applying, then the entry's check ('perl'
                        -c, or 'template': marker present exactly once +
                        </body> present), then install. Best-effort per
                        file: one file's anchors moving does not block the
                        others. Refuses to touch a file already diverted by
                        a different package.
  remove [manifest...]  Restore each entry's pristine file and remove its
                        diversion.
  verify [manifest...]  Apply each entry's diff to a scratch copy of its
                        pristine file (the diverted backup if applied, else
                        the live file) and report hunks-would-apply vs.
                        hunks-failed. Makes no changes.
  status [manifest...]  Report per-file diversion/patched/in-sync state.

  --root <dir>          Resolve every path this tool touches under <dir>
                        instead of /, and pass --root <dir> through to
                        dpkg-divert. Intended for running 'verify' (and
                        'status') against an extracted package tree in CI,
                        without touching a live system; apply/remove also
                        honor it for the same reason.

manifest arguments (optional; default: every *.json under the manifest
directory) may be a bare name (resolved to <name>.json under
/usr/share/pve-ext/patches, or next to this script in a checkout) or a
path to a manifest file directly.
EOF
}

main() {
    local -a positional=()
    while [ "$#" -gt 0 ]; do
        case "$1" in
            --root)
                [ "$#" -ge 2 ] || die "--root requires an argument"
                ROOT_DIR="${2%/}"
                shift 2
                ;;
            --root=*)
                ROOT_DIR="${1#--root=}"
                ROOT_DIR="${ROOT_DIR%/}"
                shift
                ;;
            -h | --help)
                usage
                exit 0
                ;;
            --)
                shift
                while [ "$#" -gt 0 ]; do
                    positional+=("$1")
                    shift
                done
                ;;
            -*)
                die "unknown option: $1 (see --help)"
                ;;
            *)
                positional+=("$1")
                shift
                ;;
        esac
    done

    if [ "${#positional[@]}" -eq 0 ]; then
        usage
        exit 2
    fi

    local cmd="${positional[0]}"
    local -a manifest_args=("${positional[@]:1}")

    local -a MANIFESTS=()
    select_manifests "${manifest_args[@]}"
    local manifest
    for manifest in "${MANIFESTS[@]}"; do
        parse_manifest "$manifest" >/dev/null || exit 1
    done

    case "$cmd" in
        apply) cmd_apply ;;
        remove) cmd_remove ;;
        verify) cmd_verify ;;
        status) cmd_status ;;
        *)
            usage
            exit 2
            ;;
    esac
}

main "$@"
