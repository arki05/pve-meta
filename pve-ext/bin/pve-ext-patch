#!/bin/bash
#
# pve-ext-patch - apply/remove/verify/status for pve-ext's generic
# managed-patch seam (see pve-ext/README.md, "Managed patches").
#
# A TOML-manifest-driven tool that patches an arbitrary number of files
# across an arbitrary number of packages, described declaratively instead
# of hardcoded per file:
#   1. dpkg-divert each file away (suffix ".pve-ext-orig", owned by the
#      package "pve-ext" - never by whatever package a manifest names in
#      its `package` field, which is informational/for status output
#      only), so the pristine file its real owning package ships (now and
#      on future upgrades) always lands at the diverted path, and the
#      "real" path is ours to (re)write.
#   2. Regenerate the "real" file as: pristine original + the manifest
#      entry's unified diff, applied with `patch -p1 --fuzz=0` into a
#      scratch copy - never in place, and never touching the diverted
#      pristine backup itself (only ever read). `--fuzz=0` is deliberate:
#      GNU patch's default fuzz=2 will happily slide a hunk onto the
#      wrong one of several near-identical anchors (several of the
#      lifecycle-patch targets have exactly this shape) and report
#      success - a corruption that "works" is worse than a hunk that
#      fails loudly. No manifest may claim a path another manifest has
#      already diverted (checked via a small per-path claim marker next
#      to the diversion) - stacking two manifests on one file is refused
#      with a clear error, not attempted (documented limitation, see
#      pve-ext/README.md).
#   3. Gate installation on the entry's `check`:
#        - "perl":     `perl -c` reporting "syntax OK" as the LAST line
#                       of its output (a pre-existing "Subroutine ...
#                       redefined" warning is expected noise, never the
#                       verdict, which perl always prints last).
#        - "template": the entry's `marker` string (normally the exact
#                       inserted tag) must appear in the rendered file
#                       EXACTLY once, and `</body>` must still be present
#                       - a "did this render into garbage" check, used for
#                       HTML templates like index.html.tpl.
#   4. `install -m 0644` the scratch file over the real path, only after
#      both the dry-run and the check gate pass. Best-effort per file:
#      one file's anchors moving must never block the others in the same
#      (or a different) manifest.
#
# Manifests are TOML files, normally at /usr/share/pve-ext/patches/<name>.toml
# (installed by whichever package owns that patch - pve-ext ships its own
# two-file manifest, pve-meta ships its seven-file lifecycle manifest, and
# so on for any future package that needs to patch stock PVE):
#
#   id = "pve-manager"                    # this manifest's stable claim identity
#
#   [[file]]
#   path = "/usr/share/perl5/PVE/API2.pm"
#   package = "pve-manager"
#   diff = "pve-manager_API2.pm.diff"    # relative to the manifest's own directory
#   marker = "PVE::API2::Ext->register_all();"
#   check = "perl"                        # "perl" (default) or "template"
#
# The top-level `id` is what claim_file_for()'s per-path ".claimed-by"
# marker records (see below) - a stable name for "this manifest", so that
# invoking the SAME manifest content under two different paths/basenames
# (e.g. a checkout's "patches/lifecycle.toml" vs. its installed name
# "pve-meta-lifecycle.toml") claims files under the same identity instead
# of refusing itself. A manifest with no `id` falls back to its filename
# basename, with a warning - support for that predates this field and
# exists only for manifests that haven't added it yet.
#
# Parsed by a small awk reader below - no TOML library, no Perl TOML
# module (none ship with PVE) - just dpkg-divert, patch and perl, exactly
# like the two tools this generalizes. It understands exactly the subset
# of TOML these manifests use: an optional top-level `id = "value"`
# assignment before the first table, repeated [[file]] array-of-tables
# blocks, each holding a handful of `key = "value"` (or `key = 'value'`)
# string assignments, blank lines, and '#' comments running to
# end-of-line (assumed to never appear as literal text inside a
# manifest's own string values - true for every manifest this project
# ships).
#
# Intended to be installed as /usr/sbin/pve-ext-patch and invoked from
# postinst/triggers (both pve-ext's own and every consumer package's -
# see pve-ext/README.md), but also runs fine ad hoc from a checkout.
#
set -u

PKG="pve-ext"
CANON_MANIFEST_DIR="/usr/share/pve-ext/patches"

ROOT_DIR=""
SCRATCH_ROOT=""

log() { echo "pve-ext-patch: $*"; }
warn() { echo "pve-ext-patch: WARNING: $*" >&2; }
err() { echo "pve-ext-patch: ERROR: $*" >&2; }
die() {
    err "$*"
    exit 1
}

script_dir() {
    cd "$(dirname "${BASH_SOURCE[0]}")" >/dev/null 2>&1 && pwd
}

require_cmd() {
    command -v "$1" >/dev/null 2>&1 || die "required command '$1' not found"
}

cleanup_scratch() {
    [ -n "$SCRATCH_ROOT" ] && [ -d "$SCRATCH_ROOT" ] && rm -rf -- "$SCRATCH_ROOT"
}

# --- manifest directory / resolution -----------------------------------

# Where manifests (and, by convention, the diffs they reference) live:
# prefer the canonical packaged location (under --root, if given), fall
# back to ../patches next to this script (the checkout / ad-hoc case,
# where this script sits at pve-ext/bin/pve-ext-patch and manifests at
# pve-ext/patches/*.toml).
manifest_dir() {
    local canon="${ROOT_DIR}${CANON_MANIFEST_DIR}"
    if [ -d "$canon" ]; then
        echo "$canon"
        return 0
    fi
    local checkout
    checkout="$(script_dir)/../patches"
    if [ -d "$checkout" ]; then
        echo "$checkout"
        return 0
    fi
    return 1
}

# Resolves one manifest argument (a bare name, or a path to a .toml file)
# to an absolute manifest file path. Echoes it, or returns non-zero.
resolve_manifest() {
    local arg="$1" dir
    case "$arg" in
        */* | *.toml)
            if [ -f "$arg" ]; then
                echo "$arg"
                return 0
            fi
            return 1
            ;;
        *)
            dir="$(manifest_dir)" || return 1
            if [ -f "${dir}/${arg}.toml" ]; then
                echo "${dir}/${arg}.toml"
                return 0
            fi
            return 1
            ;;
    esac
}

# Reads a manifest's own claim identity: a top-level `id = "..."` key,
# declared once, before the manifest's first `[[file]]` table (never inside
# one - a `[[file]]` entry's own fields are unrelated to this). This is what
# claim_file_for()/apply_one()/remove_one() use as the manifest's identity,
# so that two different names for the *same* manifest content (a checkout
# path like "patches/lifecycle.toml" vs. its installed name
# "pve-meta-lifecycle.toml") claim the same files instead of silently
# refusing each other (see pve-ext/README.md, "Managed patches").
# Echoes the id and returns 0, or returns 1 with nothing echoed when the
# manifest has none (an older manifest predating this field) - the caller
# falls back to the filename basename in that case, with a warning.
manifest_id() {
    local manifest="$1" id
    id="$(awk '
        function trim(s) { sub(/^[ \t]+/, "", s); sub(/[ \t]+$/, "", s); return s }
        function unquote(s,    n, c) {
            s = trim(s)
            n = length(s)
            if (n >= 2) {
                c = substr(s, 1, 1)
                if ((c == "\"" || c == "'\''") && substr(s, n, 1) == c) {
                    s = substr(s, 2, n - 2)
                }
            }
            return s
        }
        /^[ \t]*\[\[file\]\]/ { exit }
        {
            line = $0
            sub(/#.*/, "", line)
            t = trim(line)
            if (match(t, /^id[ \t]*=/)) { print unquote(substr(t, RSTART + RLENGTH)); exit }
        }
    ' "$manifest")"
    [ -n "$id" ] || return 1
    echo "$id"
}

# Resolves a manifest's claim identity: its own declared `id` field, or (with
# a warning - see manifest_id()) its filename basename as a fallback for a
# manifest that predates the field.
manifest_claim_name() {
    local manifest="$1" id
    if id="$(manifest_id "$manifest")"; then
        echo "$id"
        return 0
    fi
    warn "$manifest: no top-level 'id' field found; falling back to the filename-derived claim identity '$(basename "$manifest" .toml)' (a manifest referenced under two different paths/names then claims its files under two different identities - add an 'id' field to fix this, see pve-ext/README.md)"
    basename "$manifest" .toml
}

# Populates the global array MANIFESTS with resolved manifest file paths:
# either the given names/paths, or (with none given) every *.toml in the
# manifest directory.
select_manifests() {
    MANIFESTS=()
    if [ "$#" -eq 0 ]; then
        local dir manifest
        dir="$(manifest_dir)" || die "no manifest directory found (looked for ${ROOT_DIR}${CANON_MANIFEST_DIR} and next to this script) and no manifest named on the command line"
        for manifest in "$dir"/*.toml; do
            [ -f "$manifest" ] && MANIFESTS+=("$manifest")
        done
        [ "${#MANIFESTS[@]}" -gt 0 ] || die "no *.toml manifests found in $dir"
        return 0
    fi
    local arg resolved
    for arg in "$@"; do
        resolved="$(resolve_manifest "$arg")" || die "no such manifest: '$arg' (looked for it as a path, and as <name>.toml under the manifest directory)"
        MANIFESTS+=("$resolved")
    done
}

# --- tiny TOML reader ---------------------------------------------------
#
# Emits one line per [[file]] table found in $1, fields separated by
# 0x1f (ASCII unit separator, never legal in a TOML bare/basic string we
# care about here): path\x1fpackage\x1fdiff\x1fmarker\x1fcheck
# `check` defaults to "perl" when the table doesn't set it.
parse_manifest() {
    awk '
        function trim(s) {
            sub(/^[ \t]+/, "", s)
            sub(/[ \t]+$/, "", s)
            return s
        }
        function unquote(s,    n, c) {
            s = trim(s)
            n = length(s)
            if (n >= 2) {
                c = substr(s, 1, 1)
                if ((c == "\"" || c == "'\''") && substr(s, n, 1) == c) {
                    s = substr(s, 2, n - 2)
                }
            }
            return s
        }
        function emit() {
            if (path != "") {
                if (check == "") check = "perl"
                printf "%s\x1f%s\x1f%s\x1f%s\x1f%s\n", path, pkg, diff, marker, check
            }
            path = ""; pkg = ""; diff = ""; marker = ""; check = ""
        }
        BEGIN { path = ""; pkg = ""; diff = ""; marker = ""; check = "" }
        {
            line = $0
            sub(/#.*/, "", line)
            t = trim(line)
            if (t == "") next
            if (t == "[[file]]") { emit(); next }
            if (match(t, /^path[ \t]*=/))    { path   = unquote(substr(t, RSTART + RLENGTH)); next }
            if (match(t, /^package[ \t]*=/)) { pkg    = unquote(substr(t, RSTART + RLENGTH)); next }
            if (match(t, /^diff[ \t]*=/))    { diff   = unquote(substr(t, RSTART + RLENGTH)); next }
            if (match(t, /^marker[ \t]*=/))  { marker = unquote(substr(t, RSTART + RLENGTH)); next }
            if (match(t, /^check[ \t]*=/))   { check  = unquote(substr(t, RSTART + RLENGTH)); next }
        }
        END { emit() }
    ' "$1"
}

# --- dpkg-divert helpers (honor --root) --------------------------------

set_dpkg_root_args() {
    DPKG_ROOT_ARGS=()
    if [ -n "$ROOT_DIR" ]; then
        DPKG_ROOT_ARGS=(--root "$ROOT_DIR")
    fi
}

# All four of these take $1 = the manifest's own path (e.g.
# "/usr/share/perl5/PVE/API2.pm"), NEVER a --root-prefixed one:
# dpkg-divert's own --root already prepends ROOT_DIR to every path it
# operates on (both for its diversions-database bookkeeping and for the
# actual rename it performs), so passing an *already*-prefixed path here
# too (e.g. what real_path_for()/diverted_path_for() return, meant for
# this script's own plain `cp`/`[ -f ]`/etc., which know nothing about
# --root) would double the prefix for the on-disk rename dpkg-divert
# performs -- registering a diversion that "succeeds" (no error) but
# never actually moves the real file, silently no-op'ing `apply`/`remove`
# under --root while `status`/`verify`'s read-only lookups still appear
# consistent (they double the same prefix on both sides).
divert_arg_diverted() { echo "$1.pve-ext-orig"; }

is_diverted() {
    # $1 = manifest path
    local -a DPKG_ROOT_ARGS=()
    set_dpkg_root_args
    dpkg-divert "${DPKG_ROOT_ARGS[@]}" --truename "$1" 2>/dev/null | grep -qx "$(divert_arg_diverted "$1")"
}

diversion_owned_by_us() {
    # $1 = manifest path
    local -a DPKG_ROOT_ARGS=()
    set_dpkg_root_args
    dpkg-divert "${DPKG_ROOT_ARGS[@]}" --listpackage "$1" 2>/dev/null | grep -qx "$PKG"
}

dpkg_divert_add() {
    # $1 = manifest path
    local -a DPKG_ROOT_ARGS=()
    set_dpkg_root_args
    dpkg-divert "${DPKG_ROOT_ARGS[@]}" --package "$PKG" --add --rename --divert "$(divert_arg_diverted "$1")" "$1"
}

dpkg_divert_remove() {
    # $1 = manifest path
    local -a DPKG_ROOT_ARGS=()
    set_dpkg_root_args
    dpkg-divert "${DPKG_ROOT_ARGS[@]}" --package "$PKG" --remove --rename --divert "$(divert_arg_diverted "$1")" "$1"
}

# Canonicalizes a directory to an absolute path. apply_one/verify_one/
# status_one all `cd` into a scratch directory before reading a diff via
# `<"$diff_path"`, so a manifest directory that was relative to the
# caller's original cwd (possible when a manifest is named as an explicit
# relative path/argument, rather than resolved via manifest_dir()) would
# silently stop resolving the instant the subshell `cd`s elsewhere. Every
# `mdir` this tool computes from a manifest path goes through this first.
abs_dir() { (cd "$1" 2>/dev/null && pwd) || echo "$1"; }

real_path_for() { echo "${ROOT_DIR}$1"; }
diverted_path_for() { echo "$(real_path_for "$1").pve-ext-orig"; }
# The path used inside the scratch dir and inside each diff's a/ b/
# headers: the real path with its leading '/' stripped, so `patch -p1`
# (which strips exactly one leading path component) reconstructs it
# regardless of where under / the file actually lives.
relpath_for() { echo "${1#/}"; }

# --- per-manifest claims (no stacking two manifests on one file) -------
#
# A diversion is owned by the "pve-ext" dpkg-divert package regardless of
# which manifest created it (see the header comment), so dpkg-divert
# itself cannot tell two manifests apart. This tiny marker file, living
# next to the diversion (never touched by dpkg, so it survives package
# upgrades untouched), records which manifest currently claims the path -
# apply refuses to re-purpose a path for a different manifest, and remove
# refuses to undivert a path a different manifest still claims.

claim_file_for() { echo "$(diverted_path_for "$1").claimed-by"; }

read_claim() {
    # $1 = claim file
    [ -f "$1" ] && cat "$1" 2>/dev/null
}

write_claim() {
    # $1 = claim file, $2 = manifest name
    printf '%s\n' "$2" >"$1" 2>/dev/null
}

# --- failure reporting ---------------------------------------------------
#
# apply_one's failure branches always print to stderr (visible when run
# interactively or from a postinst that doesn't redirect it), but a
# postinst failure is deliberately swallowed (never fails install/
# configure - see pve-ext/README.md) so it can otherwise go completely
# unnoticed. Leave a durable trail in two places a human or monitoring
# actually looks: syslog, and a marker file `status`/an admin can check
# for without having captured the original postinst output.
#
# A function, not a top-level assignment: --root is parsed inside main(),
# on the very last line of the file, so a top-level `FAILURE_MARKER_DIR=
# "${ROOT_DIR}/run/pve-ext-patch"` would evaluate during the initial pass
# with ROOT_DIR still "" and bake the *real* /run/pve-ext-patch into every
# later call, regardless of --root - exactly the isolation leak every
# other root-derived path here (manifest_dir, real_path_for,
# diverted_path_for, set_dpkg_root_args) already avoids by being a
# function that re-reads $ROOT_DIR when called.
failure_marker_dir() { echo "${ROOT_DIR}/run/pve-ext-patch"; }

record_failure() {
    # $1 = mpath, $2 = message
    local dir
    dir="$(failure_marker_dir)"
    mkdir -p "$dir" 2>/dev/null
    printf '%s %s: %s\n' "$(date -Is 2>/dev/null || date)" "$1" "$2" \
        >>"${dir}/failed" 2>/dev/null
    # Under --root (CI/dev verification against an extracted tree, or a
    # scratch root for testing) the real host's syslog is not this run's
    # concern at all - and writing to it would be exactly the kind of
    # live-system side effect --root exists to avoid. Only reach for
    # logger() when operating on the real system (no --root given).
    if [ -z "$ROOT_DIR" ] && command -v logger >/dev/null 2>&1; then
        logger -t pve-ext-patch -p user.err -- "$1: $2" 2>/dev/null || true
    fi
}

# On any apply_one failure: if this run just created the diversion, undo
# it (restores the file exactly as it was before this invocation - "leave
# it untouched" for a brand-new apply). If the diversion pre-existed
# (a re-apply after an upstream package upgrade replaced the diverted
# pristine with a newer one), $real may still hold content patched
# against the *old* pristine while the rest of the package was already
# upgraded - restore the *current* pristine over it instead, so the node
# runs a consistent, unpatched-but-current file rather than a silently
# stale one. Best-effort: if even that copy fails, $real is left alone
# and the failure is still recorded via record_failure by the caller.
restore_on_failure() {
    # $1 = mpath, $2 = real, $3 = diverted, $4 = created_divert (0|1)
    local mpath="$1" real="$2" diverted="$3" created_divert="$4"
    if [ "$created_divert" -eq 1 ]; then
        log "$mpath: rolling back diversion created moments ago"
        # dpkg-divert --remove --rename refuses to rename the diverted
        # pristine backup back onto $real while $real already holds a
        # regular file - and by the time any of apply_one's later failure
        # branches reach here, $real always does (the pristine-placeholder
        # restore a few lines below install runs unconditionally before
        # the dry-run/patch/check gates, so a dry-run, patch or check
        # failure leaves $real holding that placeholder copy). remove_one
        # clears $real first for exactly this reason; do the same here -
        # skipping it turns this "rollback" into a no-op that deletes the
        # claim marker and logs success while the diversion stays live in
        # dpkg's database.
        rm -f "$real"
        if dpkg_divert_remove "$mpath" >/dev/null 2>&1; then
            rm -f "$(claim_file_for "$mpath")" 2>/dev/null
        else
            err "$mpath: FAILED to roll back the diversion just created - dpkg-divert --remove failed; the diversion is still in dpkg's database (owned by ${PKG}) and $real is now missing"
            record_failure "$mpath" "failed to roll back a freshly created diversion after a later failure - diversion still registered, claim marker left in place, $real missing"
        fi
        return
    fi
    if [ -f "$diverted" ]; then
        if cp -a "$diverted" "$real" 2>/dev/null; then
            err "$mpath: restored current pristine (unpatched) content to $real so the node stays consistent"
        else
            err "$mpath: FAILED to restore pristine to $real - it may still hold stale patched content from before this failure!"
        fi
    fi
}

# --- perl -c gate --------------------------------------------------------

perl_check_ok() {
    local file="$1"
    local out last
    out="$(perl -I "${ROOT_DIR}/usr/share/perl5" -c "$file" 2>&1)"
    last="$(printf '%s\n' "$out" | tail -n1)"
    LAST_PERL_CHECK_OUTPUT="$out"
    LAST_PERL_CHECK_VERDICT="$last"
    printf '%s' "$last" | grep -Eq 'syntax OK$'
}

# --- template gate ---------------------------------------------------

template_check_ok() {
    # $1 = file, $2 = marker (the exact tag expected exactly once)
    local file="$1" marker="$2" count
    count=$(grep -cF -- "$marker" "$file")
    if [ "$count" -ne 1 ]; then
        LAST_TEMPLATE_CHECK_VERDICT="marker appears $count time(s) (expected 1)"
        return 1
    fi
    if ! grep -qF -- '</body>' "$file"; then
        LAST_TEMPLATE_CHECK_VERDICT="</body> missing - rendered file looks malformed"
        return 1
    fi
    LAST_TEMPLATE_CHECK_VERDICT="marker present exactly once, </body> present"
    return 0
}

run_check() {
    # $1 = check type, $2 = file, $3 = marker
    case "$1" in
        perl)
            perl_check_ok "$2"
            ;;
        template)
            template_check_ok "$2" "$3"
            ;;
        *)
            err "unknown check type '$1' (must be 'perl' or 'template')"
            return 1
            ;;
    esac
}

check_verdict() {
    case "$1" in
        perl) echo "$LAST_PERL_CHECK_VERDICT" ;;
        template) echo "$LAST_TEMPLATE_CHECK_VERDICT" ;;
        *) echo "n/a" ;;
    esac
}

# --- apply --------------------------------------------------------------

apply_one() {
    # $1 = manifest dir (diffs are relative to this), $2 = path, $3 = package,
    # $4 = diff basename, $5 = marker, $6 = check, $7 = manifest name (claim owner)
    local mdir="$1" mpath="$2" mpkg="$3" mdiff="$4" marker="$5" check="$6" mname="$7"
    local real diverted diff_path work rel claim existing_claim created_divert=0

    real="$(real_path_for "$mpath")"
    diverted="$(diverted_path_for "$mpath")"
    diff_path="${mdir}/${mdiff}"
    rel="$(relpath_for "$mpath")"
    work="${SCRATCH_ROOT}/$(echo "$mpath" | tr '/' '_')"
    claim="$(claim_file_for "$mpath")"

    [ -f "$diff_path" ] || {
        err "$mpath: diff not found: $diff_path"
        record_failure "$mpath" "diff not found: $diff_path"
        return 1
    }

    if is_diverted "$mpath"; then
        if ! diversion_owned_by_us "$mpath"; then
            err "$mpath: diverted by a DIFFERENT package - refusing to touch it"
            record_failure "$mpath" "diverted by a different package - refused to touch it"
            return 1
        fi
        existing_claim="$(read_claim "$claim")"
        if [ -n "$existing_claim" ] && [ "$existing_claim" != "$mname" ]; then
            err "$mpath: already diverted for manifest '$existing_claim' - pve-ext-patch does not support two manifests patching the same file (documented limitation, see pve-ext/README.md); refusing to touch it for manifest '$mname'"
            record_failure "$mpath" "claim mismatch: already diverted for manifest '$existing_claim', refused for '$mname'"
            return 1
        fi
        log "$mpath: diversion already in place (owned by ${PKG}, manifest ${existing_claim:-$mname}); reusing pristine copy at $diverted"
        write_claim "$claim" "$mname"
    else
        [ -f "$real" ] || {
            err "$mpath: expected file not found: $real (owning package: ${mpkg:-unknown})"
            record_failure "$mpath" "expected file not found: $real (owning package: ${mpkg:-unknown})"
            return 1
        }
        log "$mpath: diverting $real -> $diverted"
        if ! dpkg_divert_add "$mpath"; then
            err "$mpath: dpkg-divert --add failed"
            record_failure "$mpath" "dpkg-divert --add failed"
            return 1
        fi
        created_divert=1
        write_claim "$claim" "$mname"
    fi

    if [ ! -f "$diverted" ]; then
        err "$mpath: pristine backup not found at $diverted after diversion - aborting this file"
        restore_on_failure "$mpath" "$real" "$diverted" "$created_divert"
        record_failure "$mpath" "pristine backup missing after diversion"
        return 1
    fi

    # A fresh divert physically moves $real away; some patched files are
    # transitively `require`d by unrelated code while we're mid-way
    # through applying a *different* file in the same run, so leaving
    # $real briefly missing can cause spurious failures elsewhere. Restore
    # the pristine placeholder for the duration of the check; `install`
    # below replaces it with the real patched content once validated.
    if [ ! -f "$real" ]; then
        if ! cp "$diverted" "$real"; then
            err "$mpath: failed to restore pristine placeholder at $real for the duration of the check"
            restore_on_failure "$mpath" "$real" "$diverted" "$created_divert"
            record_failure "$mpath" "failed to restore pristine placeholder"
            return 1
        fi
    fi

    mkdir -p "$(dirname "${work}/${rel}")" || {
        err "$mpath: mkdir scratch dir failed"
        record_failure "$mpath" "mkdir scratch dir failed"
        return 1
    }
    if ! cp "$diverted" "${work}/${rel}"; then
        err "$mpath: failed to copy pristine into scratch area"
        restore_on_failure "$mpath" "$real" "$diverted" "$created_divert"
        record_failure "$mpath" "failed to copy pristine into scratch area"
        return 1
    fi

    local dry_out
    if ! dry_out="$(cd "$work" && patch -p1 --fuzz=0 --dry-run <"$diff_path" 2>&1)"; then
        err "$mpath: patch --dry-run failed - anchors may have moved upstream"
        printf '%s\n' "$dry_out" >&2
        restore_on_failure "$mpath" "$real" "$diverted" "$created_divert"
        record_failure "$mpath" "patch --dry-run failed (anchors may have moved upstream)"
        return 1
    fi

    local apply_out
    if ! apply_out="$(cd "$work" && patch -p1 --fuzz=0 <"$diff_path" 2>&1)"; then
        err "$mpath: real patch application failed after a clean dry-run (unexpected)"
        printf '%s\n' "$apply_out" >&2
        restore_on_failure "$mpath" "$real" "$diverted" "$created_divert"
        record_failure "$mpath" "patch apply failed after a clean dry-run"
        return 1
    fi

    if ! run_check "$check" "${work}/${rel}" "$marker"; then
        err "$mpath: '$check' check failed: $(check_verdict "$check")"
        [ "$check" = "perl" ] && printf '%s\n' "$LAST_PERL_CHECK_OUTPUT" >&2
        restore_on_failure "$mpath" "$real" "$diverted" "$created_divert"
        record_failure "$mpath" "'$check' check failed: $(check_verdict "$check")"
        return 1
    fi
    log "$mpath: $check check OK ($(check_verdict "$check"))"

    if ! install -m 0644 "${work}/${rel}" "$real"; then
        err "$mpath: failed to install patched file to $real"
        record_failure "$mpath" "install of patched file failed"
        return 1
    fi
    log "$mpath: patched and installed."
    return 0
}

cmd_apply() {
    require_cmd dpkg-divert patch perl
    [ "$(id -u)" -eq 0 ] || [ -n "$ROOT_DIR" ] || die "apply must be run as root (or with --root for a non-live tree)"

    SCRATCH_ROOT="$(mktemp -d)" || die "mktemp -d failed"
    trap cleanup_scratch EXIT

    local manifest mdir mname rc=0 count=0
    for manifest in "${MANIFESTS[@]}"; do
        mdir="$(abs_dir "$(dirname "$manifest")")"
        mname="$(manifest_claim_name "$manifest")"
        log "manifest: $manifest (claim id: $mname)"
        while IFS=$'\x1f' read -r mpath mpkg mdiff marker check; do
            [ -n "$mpath" ] || continue
            count=$((count + 1))
            apply_one "$mdir" "$mpath" "$mpkg" "$mdiff" "$marker" "$check" "$mname" || rc=1
        done < <(parse_manifest "$manifest")
    done

    [ "$count" -gt 0 ] || die "no [[file]] entries found in the selected manifest(s)"

    echo
    cmd_status_quiet
    if [ "$rc" -eq 0 ]; then
        log "apply: success (${count} file(s), ${#MANIFESTS[@]} manifest(s))."
    else
        err "apply: one or more files failed - see above. Files that failed were left untouched (or reverted if just diverted); files that succeeded are installed."
    fi
    return "$rc"
}

# --- remove ---------------------------------------------------------

# Every failure here records a durable marker, for the same reason `apply_one`
# does: `prerm` runs during a package removal whose exit code dpkg largely
# swallows, so stderr is gone by the time anyone looks. A removal that half
# happened leaves a PVE file in a state somebody has to find, and "it printed
# something during an apt run last week" is not a way to find it.
remove_one() {
    # $1 = path, $2 = manifest name (claim owner)
    local mpath="$1" mname="$2"
    local real diverted claim existing_claim
    real="$(real_path_for "$mpath")"
    diverted="$(diverted_path_for "$mpath")"
    claim="$(claim_file_for "$mpath")"

    if is_diverted "$mpath"; then
        if ! diversion_owned_by_us "$mpath"; then
            err "$mpath: diverted by a DIFFERENT package - refusing to remove"
            record_failure "$mpath" "diverted by a different package - refused to remove it"
            return 1
        fi
        existing_claim="$(read_claim "$claim")"
        if [ -n "$existing_claim" ] && [ "$existing_claim" != "$mname" ]; then
            err "$mpath: diverted for a different manifest ('$existing_claim') - refusing to remove (documented limitation: no stacking support, see pve-ext/README.md)"
            record_failure "$mpath" "claim mismatch on removal: diverted for manifest '$existing_claim', asked to remove for '$mname'"
            return 1
        fi
        log "$mpath: restoring pristine file and removing diversion"
        # dpkg-divert --remove --rename refuses to rename the pristine
        # backup onto the real path while the real path already holds
        # something (our patched file always does) - clear it first.
        rm -f "$real"
        if ! dpkg_divert_remove "$mpath"; then
            err "$mpath: dpkg-divert --remove failed"
            if [ -f "$diverted" ] && [ ! -f "$real" ]; then
                err "$mpath: recovering: restoring from $diverted manually"
                cp -a "$diverted" "$real"
                record_failure "$mpath" "dpkg-divert --remove failed; pristine restored by hand from $diverted, diversion still registered"
            else
                record_failure "$mpath" "dpkg-divert --remove failed; diversion still registered"
            fi
            return 1
        fi
        rm -f "$claim"
    else
        log "$mpath: no diversion in place - nothing to restore"
    fi
    return 0
}

cmd_remove() {
    require_cmd dpkg-divert
    [ "$(id -u)" -eq 0 ] || [ -n "$ROOT_DIR" ] || die "remove must be run as root (or with --root for a non-live tree)"

    local manifest mname rc=0 count=0
    for manifest in "${MANIFESTS[@]}"; do
        mname="$(manifest_claim_name "$manifest")"
        log "manifest: $manifest (claim id: $mname)"
        while IFS=$'\x1f' read -r mpath mpkg mdiff marker check; do
            [ -n "$mpath" ] || continue
            count=$((count + 1))
            remove_one "$mpath" "$mname" || rc=1
        done < <(parse_manifest "$manifest")
    done

    echo
    cmd_status_quiet || true
    if [ "$rc" -eq 0 ]; then
        log "remove: success (${count} file(s), ${#MANIFESTS[@]} manifest(s))."
    else
        err "remove: one or more files failed - see above."
    fi
    return "$rc"
}

# --- verify ---------------------------------------------------------

verify_one() {
    # $1 = manifest dir, $2 = path, $3 = diff basename
    local mdir="$1" mpath="$2" mdiff="$3"
    local real diverted diff_path work rel pristine source_desc

    real="$(real_path_for "$mpath")"
    diverted="$(diverted_path_for "$mpath")"
    diff_path="${mdir}/${mdiff}"
    rel="$(relpath_for "$mpath")"
    work="${SCRATCH_ROOT}/$(echo "$mpath" | tr '/' '_').verify"

    [ -f "$diff_path" ] || {
        err "$mpath: diff not found: $diff_path"
        return 1
    }

    if is_diverted "$mpath" && [ -f "$diverted" ]; then
        pristine="$diverted"
        source_desc="diverted pristine backup"
    else
        pristine="$real"
        source_desc="live file (assumed pristine/unpatched)"
    fi
    [ -f "$pristine" ] || {
        err "$mpath: no pristine source found at $pristine"
        return 1
    }

    mkdir -p "$(dirname "${work}/${rel}")" || {
        err "$mpath: mkdir scratch dir failed"
        return 1
    }
    cp "$pristine" "${work}/${rel}" || {
        err "$mpath: failed to copy $pristine into scratch area"
        return 1
    }

    local dry_out rc total_hunks fail_hunks ok_hunks
    dry_out="$(cd "$work" && patch -p1 --fuzz=0 --dry-run <"$diff_path" 2>&1)"
    rc=$?
    total_hunks=$(grep -c '^@@ ' "$diff_path")
    fail_hunks=$(printf '%s\n' "$dry_out" | grep -c 'FAILED')
    if [ "$rc" -eq 0 ]; then
        ok_hunks="$total_hunks"
    else
        ok_hunks=$((total_hunks - fail_hunks))
    fi

    if [ "$rc" -eq 0 ]; then
        log "$mpath: OK - ${ok_hunks}/${total_hunks} hunks would apply cleanly against ${source_desc}"
        return 0
    else
        err "$mpath: FAIL - ${ok_hunks}/${total_hunks} hunks would apply, ${fail_hunks} failed, against ${source_desc}"
        printf '%s\n' "$dry_out" >&2
        return 1
    fi
}

cmd_verify() {
    require_cmd patch dpkg-divert

    SCRATCH_ROOT="$(mktemp -d)" || die "mktemp -d failed"
    trap cleanup_scratch EXIT

    local manifest mdir rc=0 count=0
    for manifest in "${MANIFESTS[@]}"; do
        mdir="$(abs_dir "$(dirname "$manifest")")"
        log "manifest: $manifest"
        while IFS=$'\x1f' read -r mpath mpkg mdiff marker check; do
            [ -n "$mpath" ] || continue
            count=$((count + 1))
            verify_one "$mdir" "$mpath" "$mdiff" || rc=1
        done < <(parse_manifest "$manifest")
    done

    if [ "$rc" -eq 0 ]; then
        log "verify: all selected files (${count}) would apply cleanly."
    else
        err "verify: one or more files would NOT apply cleanly - do not trust apply() without investigating."
    fi
    return "$rc"
}

# --- status ---------------------------------------------------------

status_one() {
    # $1 = path, $2 = manifest dir, $3 = diff basename, $4 = marker, $5 = check, $6 = package
    local mpath="$1" mdir="$2" mdiff="$3" marker="$4" check="$5" mpkg="$6"
    local real diverted diff_path claim claimed_by
    real="$(real_path_for "$mpath")"
    diverted="$(diverted_path_for "$mpath")"
    diff_path="${mdir}/${mdiff}"
    claim="$(claim_file_for "$mpath")"
    claimed_by="$(read_claim "$claim")"

    local diverted_flag=0 owned_flag=0 pristine_flag=0 patched_flag=0 insync_flag=0 insync_checked=0

    is_diverted "$mpath" && diverted_flag=1
    if [ "$diverted_flag" -eq 1 ]; then
        diversion_owned_by_us "$mpath" && owned_flag=1
        [ -f "$diverted" ] && pristine_flag=1
    fi
    [ -f "$real" ] && grep -qF -- "$marker" "$real" && patched_flag=1

    # "In sync" means: applying the diff to the *current* pristine backup
    # reproduces $real byte-for-byte. Deliberately forward (pristine + diff
    # -> candidate, then cmp against $real), not a reverse-apply of the
    # diff against $real itself: a reverse dry-run only proves the diff's
    # hunks *could* un-apply somewhere in $real - it says nothing about
    # whether $real still matches the *current* pristine (e.g. after an
    # unrelated package upgrade replaced the diverted pristine with a
    # newer one while $real still holds content patched against the old
    # one), so it can report "in sync: yes" against a file that is
    # actually stale. A forward-rebuild-and-compare cannot make that
    # mistake, and it also catches the marker being missing from a
    # supposedly-applied file, since a missing/altered marker line means
    # the candidate cannot match $real either.
    if [ "$diverted_flag" -eq 1 ] && [ "$pristine_flag" -eq 1 ] && [ -f "$real" ] \
        && [ -f "$diff_path" ] && [ -n "$SCRATCH_ROOT" ]; then
        local rel work
        rel="$(relpath_for "$mpath")"
        work="${SCRATCH_ROOT}/$(echo "$mpath" | tr '/' '_').status"
        mkdir -p "$(dirname "${work}/${rel}")" 2>/dev/null
        if cp "$diverted" "${work}/${rel}" 2>/dev/null; then
            if (cd "$work" && patch -p1 --fuzz=0 <"$diff_path") >/dev/null 2>&1; then
                insync_checked=1
                cmp -s "${work}/${rel}" "$real" && insync_flag=1
            fi
        fi
    fi

    echo "  ${mpath} (package: ${mpkg:-unknown}, check: ${check}):"
    if [ "$diverted_flag" -eq 1 ]; then
        if [ "$owned_flag" -eq 1 ]; then
            echo "    diversion:       APPLIED (owned by ${PKG})"
        else
            echo "    diversion:       APPLIED (owned by a DIFFERENT package - unexpected!)"
        fi
        echo "    pristine backup: $([ "$pristine_flag" -eq 1 ] && echo "present ($diverted)" || echo "MISSING")"
        echo "    claimed by:      ${claimed_by:-<none recorded>}"
    else
        echo "    diversion:       not applied"
    fi
    echo "    patched:         $([ "$patched_flag" -eq 1 ] && echo "yes (marker present in $real)" || echo "no")"
    if [ "$insync_checked" -eq 1 ]; then
        echo "    in sync w/ diff: $([ "$insync_flag" -eq 1 ] && echo "yes" || echo "no (live file does not exactly match diff's expected output)")"
    fi

    if [ "$diverted_flag" -eq 1 ] && [ "$owned_flag" -eq 1 ] && [ "$pristine_flag" -eq 1 ] && [ "$patched_flag" -eq 1 ]; then
        echo "    overall:         APPLIED"
        return 0
    else
        echo "    overall:         NOT APPLIED"
        return 1
    fi
}

cmd_status_quiet() { cmd_status; }

cmd_status() {
    require_cmd dpkg-divert
    if [ -z "$SCRATCH_ROOT" ]; then
        SCRATCH_ROOT="$(mktemp -d)" || SCRATCH_ROOT=""
        [ -n "$SCRATCH_ROOT" ] && trap cleanup_scratch EXIT
    fi

    echo "pve-ext-patch status:"
    local manifest mdir rc=0
    for manifest in "${MANIFESTS[@]}"; do
        echo " manifest: $manifest"
        mdir="$(abs_dir "$(dirname "$manifest")")"
        while IFS=$'\x1f' read -r mpath mpkg mdiff marker check; do
            [ -n "$mpath" ] || continue
            status_one "$mpath" "$mdir" "$mdiff" "$marker" "$check" "$mpkg" || rc=1
        done < <(parse_manifest "$manifest")
    done
    return "$rc"
}

# --- manifest-id ------------------------------------------------------
#
# Prints a manifest's own declared claim identity (its top-level `id`
# field - see manifest_id()'s header comment) with NO basename fallback:
# a caller of this subcommand wants the exact identity apply/remove will
# claim files under, so a manifest that hasn't added `id` yet is an error
# here rather than a silent guess. Exists so that anything needing that
# identity outside this script - e.g. the root Makefile's `install`
# target, which installs patches/lifecycle.toml under its declared id -
# resolves it through this tool's own TOML reader instead of maintaining
# a second, independently-drifting awk one-liner.
cmd_manifest_id() {
    [ "${#MANIFESTS[@]}" -eq 1 ] || die "manifest-id takes exactly one manifest argument"
    manifest_id "${MANIFESTS[0]}" || die "${MANIFESTS[0]}: no top-level 'id' field found"
}

# --- usage / main -----------------------------------------------------

usage() {
    cat <<EOF
Usage: $(basename "$0") [--root <dir>] <apply|remove|verify|status> [manifest...]
       $(basename "$0") manifest-id <manifest-file>

  apply [manifest...]   Divert each entry's file (if not already), apply its
                        diff (patch -p1 --fuzz=0) into a scratch copy, gate
                        on a clean dry-run then the entry's check ('perl'
                        -c, or 'template': marker present exactly once +
                        </body> present), then install. Best-effort per
                        file: one file's anchors moving does not block the
                        others. Refuses (with a clear error) to patch a
                        file already diverted for a different manifest -
                        two manifests can never stack on one file.
  remove [manifest...]  Restore each entry's pristine file and remove its
                        diversion.
  verify [manifest...]  'patch --dry-run' each entry's diff against its
                        pristine copy (the diverted backup if applied, else
                        the live file) and report hunks-would-apply vs.
                        hunks-failed. Makes no changes.
  status [manifest...]  Report per-file diversion/patched/in-sync state.
  manifest-id <file>    Print the manifest's own declared claim identity
                        (its top-level 'id' field; no basename fallback -
                        errors if the field is absent). For build/install
                        tooling that needs the exact identity apply/remove
                        will claim files under, e.g. to install a manifest
                        under its declared id without re-implementing this
                        tool's TOML 'id' parsing.

  --root <dir>          Resolve every path this tool touches under <dir>
                        instead of /, and pass --root <dir> through to
                        dpkg-divert. Intended for running 'verify' (and
                        'status') against an extracted package tree in CI,
                        without touching a live system; apply/remove also
                        honor it for the same reason.

manifest arguments (optional; default: every *.toml under the manifest
directory) may be a bare name (resolved to <name>.toml under
/usr/share/pve-ext/patches, or next to this script in a checkout) or a
path to a manifest file directly.
EOF
}

main() {
    local -a positional=()
    while [ "$#" -gt 0 ]; do
        case "$1" in
            --root)
                [ "$#" -ge 2 ] || die "--root requires an argument"
                ROOT_DIR="${2%/}"
                shift 2
                ;;
            --root=*)
                ROOT_DIR="${1#--root=}"
                ROOT_DIR="${ROOT_DIR%/}"
                shift
                ;;
            -h | --help)
                usage
                exit 0
                ;;
            --)
                shift
                while [ "$#" -gt 0 ]; do
                    positional+=("$1")
                    shift
                done
                ;;
            -*)
                die "unknown option: $1 (see --help)"
                ;;
            *)
                positional+=("$1")
                shift
                ;;
        esac
    done

    if [ "${#positional[@]}" -eq 0 ]; then
        usage
        exit 2
    fi

    local cmd="${positional[0]}"
    local -a manifest_args=("${positional[@]:1}")

    local -a MANIFESTS=()
    select_manifests "${manifest_args[@]}"

    case "$cmd" in
        apply) cmd_apply ;;
        remove) cmd_remove ;;
        verify) cmd_verify ;;
        status) cmd_status ;;
        manifest-id) cmd_manifest_id ;;
        *)
            usage
            exit 2
            ;;
    esac
}

main "$@"
