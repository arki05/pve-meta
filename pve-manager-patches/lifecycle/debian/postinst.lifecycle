# postinst snippet for the pve-meta package - lifecycle-hook variant.
#
# Applies (or re-applies) the seven PVE::RS::Meta lifecycle-hook patches
# (see docs/LIFECYCLE-PATCHES.md) on initial configure, and again whenever
# dpkg triggers us because libpve-guest-common-perl, pve-container, or
# qemu-server shipped a new copy of one of the seven patched files (see
# debian/pve-meta.triggers.lifecycle). Fold this into the real pve-meta
# package's postinst alongside postinst (the UI-patch variant); this file
# is a snippet, not a standalone maintainer script.
#
# Re-running `pve-meta-lifecycle-patch apply` is safe and idempotent: each
# file reuses its existing dpkg-divert diversion, re-derives the patched
# file from the (possibly-updated) pristine original via `patch`, and
# gates installation on `perl -c` reporting syntax OK. It is also
# best-effort per file: one file's anchors moving on some future point
# release does not stop the other six from being (re-)patched.

PVE_META_LIFECYCLE_PATCH=/usr/sbin/pve-meta-lifecycle-patch

apply_lifecycle_patch() {
    if [ -x "$PVE_META_LIFECYCLE_PATCH" ]; then
        # Never let a failure here break the pve-manager/pve-meta install;
        # a metadata lifecycle hook silently not being wired for one file
        # on one PVE point release is far less bad than breaking `apt
        # upgrade` for the whole host. `pve-meta-lifecycle-patch status`
        # can be used afterwards to diagnose.
        "$PVE_META_LIFECYCLE_PATCH" apply || {
            echo "pve-meta: warning: pve-meta-lifecycle-patch apply failed for one or more files, see above." >&2
        }
    else
        echo "pve-meta: warning: $PVE_META_LIFECYCLE_PATCH not found or not executable." >&2
    fi
}

case "$1" in
    configure)
        apply_lifecycle_patch
        ;;
    triggered)
        # $2 is the whitespace-separated list of trigger names that fired;
        # for any of our seven triggers, just re-apply (best-effort, all
        # seven files, as above).
        apply_lifecycle_patch
        ;;
    abort-upgrade|abort-remove|abort-deconfigure)
        ;;
    *)
        ;;
esac
