#!/bin/bash
#
# pve-meta-lifecycle-patch - apply/remove/verify/status for the eight
# lifecycle-hook patches that wire PVE::RS::Meta into stock PVE 9.x Perl
# (snapshot/rollback/delsnap/clone/destroy/backup/restore) and register the
# native PVE::API2::Meta module in PVE::API2. See docs/LIFECYCLE-PATCHES.md
# section 10 for the design this implements.
#
# Mechanism (same shape as pve-manager-patch/pve-meta-patch, generalized to
# eight files across four packages with multiple insertion points each):
#   1. dpkg-divert each real file away, so the pristine file each package
#      ships (now and on future upgrades) always lands next to the real
#      path, suffixed ".pve-meta-orig", and the "real" name is ours to
#      (re)write.
#   2. Regenerate the "real" file as: pristine original + the file's
#      unified diff (pve-manager-patches/lifecycle/*.diff), applied with
#      `patch -p1` into a scratch copy - never in place.
#   3. Gate installation on `perl -c` reporting "syntax OK" as the LAST
#      line of its output (pre-existing "Subroutine ... redefined"
#      warnings are expected noise and never trusted over the final
#      verdict).
#
# This script is intended to be installed as /usr/sbin/pve-meta-lifecycle-
# patch and invoked from the pve-meta package's postinst/triggers (see
# debian/postinst.lifecycle, debian/postrm.lifecycle,
# debian/pve-meta.triggers.lifecycle), but it can also be run ad hoc (e.g.
# straight from a checkout) for testing.
#
set -u

PKG="pve-meta"
BASE_PERL5="/usr/share/perl5"

# key|relative-path-under-BASE_PERL5|diff-file-basename|patch-marker
#
# All eight files live under the same vendor perl5 tree, so the diff's
# "a/<relpath>" / "b/<relpath>" headers apply directly with `patch -p1`
# from a scratch dir containing just that one relative path.
#
# The fourth field is a per-file marker string - a cheap, reliable "is this
# file patched at all" needle used by verify/status, mirroring the existing
# tool's single-string INSERT_LINE grep idiom. Seven of the eight files gain
# `use PVE::RS::Meta;` directly (see each diff's "use" hunk); PVE/API2.pm's
# diff only adds `use PVE::API2::Meta;` plus a `register_method` block (it
# calls into PVE::RS::Meta only indirectly, through PVE::API2::Meta itself),
# so it needs its own marker: the `subclass => "PVE::API2::Meta"` text
# present verbatim in that diff's added block, and not a substring any of
# the other seven files would already contain.
LIFECYCLE_FILES=(
    "AbstractConfig|PVE/AbstractConfig.pm|libpve-guest-common-perl_AbstractConfig.pm.diff|use PVE::RS::Meta;"
    "API2-LXC|PVE/API2/LXC.pm|pve-container_API2-LXC.pm.diff|use PVE::RS::Meta;"
    "LXC-Create|PVE/LXC/Create.pm|pve-container_LXC-Create.pm.diff|use PVE::RS::Meta;"
    "VZDump-LXC|PVE/VZDump/LXC.pm|pve-container_VZDump-LXC.pm.diff|use PVE::RS::Meta;"
    "API2-Qemu|PVE/API2/Qemu.pm|qemu-server_API2-Qemu.pm.diff|use PVE::RS::Meta;"
    "QemuServer|PVE/QemuServer.pm|qemu-server_QemuServer.pm.diff|use PVE::RS::Meta;"
    "VZDump-QemuServer|PVE/VZDump/QemuServer.pm|qemu-server_VZDump-QemuServer.pm.diff|use PVE::RS::Meta;"
    "API2|PVE/API2.pm|pve-manager_API2.pm.diff|subclass => \"PVE::API2::Meta\""
)

ROOT_DIR=""
DIFF_DIR=""
SCRATCH_ROOT=""

log()  { echo "pve-meta-lifecycle-patch: $*"; }
err()  { echo "pve-meta-lifecycle-patch: ERROR: $*" >&2; }
die()  { err "$*"; exit 1; }

script_dir() {
    cd "$(dirname "${BASH_SOURCE[0]}")" >/dev/null 2>&1 && pwd
}

require_cmd() {
    command -v "$1" >/dev/null 2>&1 || die "required command '$1' not found"
}

# Find the directory holding the eight *.diff payloads: prefer the
# canonical packaged location, fall back to a copy sitting next to this
# script (the checkout / ad-hoc testing case).
find_diff_dir() {
    local candidates=(
        "/usr/share/${PKG}/lifecycle"
        "$(script_dir)"
    )
    local c
    for c in "${candidates[@]}"; do
        if [ -f "${c}/libpve-guest-common-perl_AbstractConfig.pm.diff" ]; then
            echo "$c"
            return 0
        fi
    done
    return 1
}

cleanup_scratch() {
    [ -n "$SCRATCH_ROOT" ] && [ -d "$SCRATCH_ROOT" ] && rm -rf -- "$SCRATCH_ROOT"
}

# --- path helpers -----------------------------------------------------

real_path_for()      { echo "${ROOT_DIR}${BASE_PERL5}/$1"; }
diverted_path_for()  { echo "$(real_path_for "$1").pve-meta-orig"; }

# --- dpkg-divert helpers (all take the already-computed real/diverted
#     paths, and honor --root for the extracted-package-tree / CI case) --

# Sets the global array DPKG_ROOT_ARGS to the --root arguments to pass
# through to dpkg-divert, if --root was given. Avoids `mapfile` (not on
# every bash this might be smoke-tested with) for a plain array build.
set_dpkg_root_args() {
    DPKG_ROOT_ARGS=()
    if [ -n "$ROOT_DIR" ]; then
        DPKG_ROOT_ARGS=(--root "$ROOT_DIR")
    fi
}

is_diverted() {
    # $1 = real path, $2 = diverted path
    local -a DPKG_ROOT_ARGS=()
    set_dpkg_root_args
    dpkg-divert "${DPKG_ROOT_ARGS[@]}" --truename "$1" 2>/dev/null | grep -qx "$2"
}

diversion_owned_by_us() {
    # $1 = real path
    local -a DPKG_ROOT_ARGS=()
    set_dpkg_root_args
    dpkg-divert "${DPKG_ROOT_ARGS[@]}" --listpackage "$1" 2>/dev/null | grep -qx "$PKG"
}

dpkg_divert_add() {
    # $1 = real path, $2 = diverted path
    local -a DPKG_ROOT_ARGS=()
    set_dpkg_root_args
    dpkg-divert "${DPKG_ROOT_ARGS[@]}" --package "$PKG" --add --rename --divert "$2" "$1"
}

dpkg_divert_remove() {
    # $1 = real path, $2 = diverted path
    local -a DPKG_ROOT_ARGS=()
    set_dpkg_root_args
    dpkg-divert "${DPKG_ROOT_ARGS[@]}" --package "$PKG" --remove --rename --divert "$2" "$1"
}

# --- file-selection -----------------------------------------------------

entry_matches() {
    # $1 = key, $2 = relpath, $3 = difffile, $4 = user pattern
    local key="$1" relpath="$2" difffile="$3" pattern="$4"
    local real
    real="$(real_path_for "$relpath")"
    [ "$pattern" = "$key" ] && return 0
    [ "$pattern" = "$relpath" ] && return 0
    [ "$pattern" = "${BASE_PERL5}/${relpath}" ] && return 0
    [ "$pattern" = "$real" ] && return 0
    [ "$pattern" = "$difffile" ] && return 0
    [ "$pattern" = "$(basename "$relpath")" ] && return 0
    return 1
}

# Populates the global array SELECTED with the entries (from
# LIFECYCLE_FILES) matching the given patterns; with no patterns, selects
# all eight. Dies if a pattern matches nothing.
select_entries() {
    SELECTED=()
    if [ "$#" -eq 0 ]; then
        SELECTED=("${LIFECYCLE_FILES[@]}")
        return 0
    fi
    local pattern entry key relpath difffile marker found
    for pattern in "$@"; do
        found=0
        for entry in "${LIFECYCLE_FILES[@]}"; do
            IFS='|' read -r key relpath difffile marker <<<"$entry"
            if entry_matches "$key" "$relpath" "$difffile" "$pattern"; then
                SELECTED+=("$entry")
                found=1
            fi
        done
        [ "$found" -eq 1 ] || die "no known lifecycle file matches '$pattern' (see 'status' with no args for the full list)"
    done
}

# --- perl -c gate ---------------------------------------------------

# Runs `perl -c` on $1 and returns 0 only if the LAST line of its combined
# output ends in "syntax OK" - pre-existing "Subroutine ... redefined"
# warnings during compilation are expected noise and must never be
# mistaken for the verdict, which perl always prints last.
perl_check_ok() {
    local file="$1"
    local out last
    out="$(perl -I "${ROOT_DIR}${BASE_PERL5}" -c "$file" 2>&1)"
    last="$(printf '%s\n' "$out" | tail -n1)"
    LAST_PERL_CHECK_OUTPUT="$out"
    LAST_PERL_CHECK_VERDICT="$last"
    printf '%s' "$last" | grep -Eq 'syntax OK$'
}

# --- apply ------------------------------------------------------------

apply_one() {
    local key="$1" relpath="$2" difffile="$3"
    local real diverted diff_path work created_divert=0

    real="$(real_path_for "$relpath")"
    diverted="$(diverted_path_for "$relpath")"
    diff_path="${DIFF_DIR}/${difffile}"
    work="${SCRATCH_ROOT}/${key}"

    [ -f "$diff_path" ] || { err "$relpath: diff not found: $diff_path"; return 1; }

    if is_diverted "$real" "$diverted"; then
        if ! diversion_owned_by_us "$real"; then
            err "$relpath: diverted by a DIFFERENT package - refusing to touch it"
            return 1
        fi
        log "$relpath: diversion already in place (owned by ${PKG}); reusing pristine copy at $diverted"
    else
        [ -f "$real" ] || { err "$relpath: expected file not found: $real"; return 1; }
        log "$relpath: diverting $real -> $diverted"
        if ! dpkg_divert_add "$real" "$diverted"; then
            err "$relpath: dpkg-divert --add failed"
            return 1
        fi
        created_divert=1
    fi

    if [ ! -f "$diverted" ]; then
        err "$relpath: pristine backup not found at $diverted after diversion - aborting this file"
        [ "$created_divert" -eq 1 ] && dpkg_divert_remove "$real" "$diverted" >/dev/null 2>&1
        return 1
    fi

    # dpkg-divert --add --rename physically moves the file that used to be
    # at $real onto $diverted, so right after a fresh diversion $real does
    # not exist at all until we `install` moments from now. Some of the
    # seven files are self-referential through the wider PVE module graph
    # (e.g. PVE::HA::Resources::PVECT does `use base 'PVE::API2::LXC'`,
    # which triggers a plain `require PVE/API2/LXC.pm` via @INC - resolved
    # against the real installed path, not our scratch copy - the moment
    # anything pulls it in transitively while we `perl -c` a DIFFERENT
    # one of the seven files). Leaving $real briefly empty makes that
    # `require` fail with "Can't locate ... in @INC" even though nothing
    # is actually broken, so restore the pristine content to $real for the
    # duration of the check; it is replaced with the real patched content
    # by `install` below once validated (a no-op if $real already holds
    # content, e.g. a previously-installed patched version on a re-apply).
    if [ ! -f "$real" ]; then
        if ! cp "$diverted" "$real"; then
            err "$relpath: failed to restore pristine placeholder at $real for the duration of the check"
            [ "$created_divert" -eq 1 ] && dpkg_divert_remove "$real" "$diverted" >/dev/null 2>&1
            return 1
        fi
    fi

    mkdir -p "$(dirname "${work}/${relpath}")" || { err "$relpath: mkdir scratch dir failed"; return 1; }
    if ! cp "$diverted" "${work}/${relpath}"; then
        err "$relpath: failed to copy pristine into scratch area"
        [ "$created_divert" -eq 1 ] && dpkg_divert_remove "$real" "$diverted" >/dev/null 2>&1
        return 1
    fi

    local dry_out
    if ! dry_out="$(cd "$work" && patch -p1 --dry-run <"$diff_path" 2>&1)"; then
        err "$relpath: patch --dry-run failed - anchors may have moved upstream; leaving this file untouched"
        printf '%s\n' "$dry_out" >&2
        if [ "$created_divert" -eq 1 ]; then
            log "$relpath: rolling back diversion created moments ago (no other file is affected)"
            dpkg_divert_remove "$real" "$diverted" >/dev/null 2>&1
        fi
        return 1
    fi

    local apply_out
    if ! apply_out="$(cd "$work" && patch -p1 <"$diff_path" 2>&1)"; then
        err "$relpath: real patch application failed after a clean dry-run (unexpected)"
        printf '%s\n' "$apply_out" >&2
        if [ "$created_divert" -eq 1 ]; then
            dpkg_divert_remove "$real" "$diverted" >/dev/null 2>&1
        fi
        return 1
    fi

    if ! perl_check_ok "${work}/${relpath}"; then
        err "$relpath: perl -c did not report syntax OK as its last line (verdict: '$LAST_PERL_CHECK_VERDICT')"
        printf '%s\n' "$LAST_PERL_CHECK_OUTPUT" >&2
        if [ "$created_divert" -eq 1 ]; then
            dpkg_divert_remove "$real" "$diverted" >/dev/null 2>&1
        fi
        return 1
    fi
    log "$relpath: perl -c OK ($LAST_PERL_CHECK_VERDICT)"

    if ! install -m 0644 "${work}/${relpath}" "$real"; then
        err "$relpath: failed to install patched file to $real"
        return 1
    fi
    log "$relpath: patched and installed."
    return 0
}

cmd_apply() {
    require_cmd dpkg-divert patch perl
    [ "$(id -u)" -eq 0 ] || [ -n "$ROOT_DIR" ] || die "apply must be run as root (or with --root for a non-live tree)"

    DIFF_DIR="$(find_diff_dir)" || die "could not find the lifecycle *.diff files (looked next to this script and in /usr/share/${PKG}/lifecycle)"
    SCRATCH_ROOT="$(mktemp -d)" || die "mktemp -d failed"
    trap cleanup_scratch EXIT

    local entry key relpath difffile marker rc=0
    for entry in "${SELECTED[@]}"; do
        IFS='|' read -r key relpath difffile marker <<<"$entry"
        apply_one "$key" "$relpath" "$difffile" || rc=1
    done

    echo
    cmd_status_quiet
    if [ "$rc" -eq 0 ]; then
        log "apply: success (${#SELECTED[@]} file(s))."
    else
        err "apply: one or more files failed - see above. Files that failed were left untouched (or reverted if just diverted); files that succeeded are installed."
    fi
    return "$rc"
}

# --- remove -------------------------------------------------------------

remove_one() {
    local key="$1" relpath="$2"
    local real diverted
    real="$(real_path_for "$relpath")"
    diverted="$(diverted_path_for "$relpath")"

    if is_diverted "$real" "$diverted"; then
        if ! diversion_owned_by_us "$real"; then
            err "$relpath: diverted by a DIFFERENT package - refusing to remove"
            return 1
        fi
        log "$relpath: restoring pristine file and removing diversion"
        # Mirrors pve-manager-patch/pve-meta-patch: dpkg-divert --remove
        # --rename refuses to rename the pristine backup back onto the
        # real path while the real path already holds something (our
        # patched file always does) - clear it first so the rename-back
        # has an empty destination. The pristine content is never at risk:
        # it only ever disappears once dpkg-divert's rename succeeds.
        rm -f "$real"
        if ! dpkg_divert_remove "$real" "$diverted"; then
            err "$relpath: dpkg-divert --remove failed"
            if [ -f "$diverted" ] && [ ! -f "$real" ]; then
                err "$relpath: recovering: restoring from $diverted manually"
                cp -a "$diverted" "$real"
            fi
            return 1
        fi
    else
        log "$relpath: no diversion in place - nothing to restore"
    fi
    return 0
}

cmd_remove() {
    require_cmd dpkg-divert
    [ "$(id -u)" -eq 0 ] || [ -n "$ROOT_DIR" ] || die "remove must be run as root (or with --root for a non-live tree)"

    local entry key relpath difffile marker rc=0
    for entry in "${SELECTED[@]}"; do
        IFS='|' read -r key relpath difffile marker <<<"$entry"
        remove_one "$key" "$relpath" || rc=1
    done

    echo
    cmd_status_quiet || true
    if [ "$rc" -eq 0 ]; then
        log "remove: success (${#SELECTED[@]} file(s))."
    else
        err "remove: one or more files failed - see above."
    fi
    return "$rc"
}

# --- verify ---------------------------------------------------------

verify_one() {
    local key="$1" relpath="$2" difffile="$3"
    local real diverted diff_path work pristine source_desc

    real="$(real_path_for "$relpath")"
    diverted="$(diverted_path_for "$relpath")"
    diff_path="${DIFF_DIR}/${difffile}"
    work="${SCRATCH_ROOT}/${key}"

    [ -f "$diff_path" ] || { err "$relpath: diff not found: $diff_path"; return 1; }

    if is_diverted "$real" "$diverted" && [ -f "$diverted" ]; then
        pristine="$diverted"
        source_desc="diverted pristine backup"
    else
        pristine="$real"
        source_desc="live file (assumed pristine/unpatched)"
    fi
    [ -f "$pristine" ] || { err "$relpath: no pristine source found at $pristine"; return 1; }

    mkdir -p "$(dirname "${work}/${relpath}")" || { err "$relpath: mkdir scratch dir failed"; return 1; }
    cp "$pristine" "${work}/${relpath}" || { err "$relpath: failed to copy $pristine into scratch area"; return 1; }

    local dry_out rc total_hunks fail_hunks ok_hunks
    dry_out="$(cd "$work" && patch -p1 --dry-run <"$diff_path" 2>&1)"
    rc=$?
    total_hunks=$(grep -c '^@@ ' "$diff_path")
    # GNU patch only prints a per-hunk "Hunk #N succeeded at ..." line when
    # applying at an offset from its expected location (silent - just
    # "checking file ..." - when every hunk lands exactly where expected),
    # but a file's overall exit status is 0 iff *every* hunk in it applied
    # (patch still applies the others and leaves .rej-worthy failures
    # otherwise, but exits non-zero for that file if any hunk failed) - so
    # derive ok_hunks from total minus failures rather than counting
    # "succeeded" lines, which would under-report on a clean, no-offset
    # apply.
    fail_hunks=$(printf '%s\n' "$dry_out" | grep -c 'FAILED')
    if [ "$rc" -eq 0 ]; then
        ok_hunks="$total_hunks"
    else
        ok_hunks=$((total_hunks - fail_hunks))
    fi

    if [ "$rc" -eq 0 ]; then
        log "$relpath: OK - ${ok_hunks}/${total_hunks} hunks would apply cleanly against ${source_desc}"
        return 0
    else
        err "$relpath: FAIL - ${ok_hunks}/${total_hunks} hunks would apply, ${fail_hunks} failed, against ${source_desc}"
        printf '%s\n' "$dry_out" >&2
        return 1
    fi
}

cmd_verify() {
    require_cmd patch dpkg-divert

    DIFF_DIR="$(find_diff_dir)" || die "could not find the lifecycle *.diff files (looked next to this script and in /usr/share/${PKG}/lifecycle)"
    SCRATCH_ROOT="$(mktemp -d)" || die "mktemp -d failed"
    trap cleanup_scratch EXIT

    local entry key relpath difffile marker rc=0
    for entry in "${SELECTED[@]}"; do
        IFS='|' read -r key relpath difffile marker <<<"$entry"
        verify_one "$key" "$relpath" "$difffile" || rc=1
    done

    if [ "$rc" -eq 0 ]; then
        log "verify: all selected files would apply cleanly."
    else
        err "verify: one or more files would NOT apply cleanly - do not trust apply() without investigating."
    fi
    return "$rc"
}

# --- status ---------------------------------------------------------

status_one() {
    local key="$1" relpath="$2" difffile="$3" marker="$4"
    local real diverted diff_path
    real="$(real_path_for "$relpath")"
    diverted="$(diverted_path_for "$relpath")"
    diff_path="${DIFF_DIR}/${difffile}"

    local diverted_flag=0 owned_flag=0 pristine_flag=0 patched_flag=0 insync_flag=0 insync_checked=0

    is_diverted "$real" "$diverted" && diverted_flag=1
    if [ "$diverted_flag" -eq 1 ]; then
        diversion_owned_by_us "$real" && owned_flag=1
        [ -f "$diverted" ] && pristine_flag=1
    fi
    [ -f "$real" ] && grep -qF -- "$marker" "$real" && patched_flag=1

    if [ -f "$real" ] && [ -f "$diff_path" ] && [ -n "$SCRATCH_ROOT" ]; then
        local work="${SCRATCH_ROOT}/${key}.status"
        mkdir -p "$(dirname "${work}/${relpath}")" 2>/dev/null
        if cp "$real" "${work}/${relpath}" 2>/dev/null; then
            insync_checked=1
            if (cd "$work" && patch -p1 -R --dry-run <"$diff_path") >/dev/null 2>&1; then
                insync_flag=1
            fi
        fi
    fi

    echo "  ${key} (${relpath}):"
    if [ "$diverted_flag" -eq 1 ]; then
        if [ "$owned_flag" -eq 1 ]; then
            echo "    diversion:       APPLIED (owned by ${PKG})"
        else
            echo "    diversion:       APPLIED (owned by a DIFFERENT package - unexpected!)"
        fi
        echo "    pristine backup: $([ "$pristine_flag" -eq 1 ] && echo "present ($diverted)" || echo "MISSING")"
    else
        echo "    diversion:       not applied"
    fi
    echo "    patched:         $([ "$patched_flag" -eq 1 ] && echo "yes (marker present in $real)" || echo "no")"
    if [ "$insync_checked" -eq 1 ]; then
        echo "    in sync w/ diff: $([ "$insync_flag" -eq 1 ] && echo "yes" || echo "no (live file does not exactly match diff's expected output)")"
    fi

    if [ "$diverted_flag" -eq 1 ] && [ "$owned_flag" -eq 1 ] && [ "$pristine_flag" -eq 1 ] && [ "$patched_flag" -eq 1 ]; then
        echo "    overall:         APPLIED"
        return 0
    else
        echo "    overall:         NOT APPLIED"
        return 1
    fi
}

cmd_status_quiet() {
    # Used internally by apply/remove to print a status recap without
    # re-requiring dpkg-divert/patch presence checks or dying.
    cmd_status
}

cmd_status() {
    require_cmd dpkg-divert
    DIFF_DIR="$(find_diff_dir 2>/dev/null)" || DIFF_DIR=""
    if [ -z "$SCRATCH_ROOT" ]; then
        SCRATCH_ROOT="$(mktemp -d)" || SCRATCH_ROOT=""
        [ -n "$SCRATCH_ROOT" ] && trap cleanup_scratch EXIT
    fi

    echo "pve-meta-lifecycle-patch status:"
    local entry key relpath difffile marker rc=0
    for entry in "${SELECTED[@]}"; do
        IFS='|' read -r key relpath difffile marker <<<"$entry"
        status_one "$key" "$relpath" "$difffile" "$marker" || rc=1
    done
    return "$rc"
}

# --- usage / main -----------------------------------------------------

usage() {
    cat <<EOF
Usage: $(basename "$0") [--root <dir>] <apply|remove|verify|status> [file...]

  apply [file...]   Divert each file (if not already), apply its diff into
                    a scratch copy, gate on 'patch --dry-run' then 'perl -c'
                    reporting syntax OK as the LAST line, then install.
                    Best-effort per file: one file's anchors moving does
                    not block applying the other seven.
  remove [file...]  Restore the pristine file and remove its diversion.
  verify [file...]  'patch --dry-run' each file's diff against its pristine
                    copy (the diverted backup if applied, else the live
                    file) and report hunks-would-apply vs. hunks-failed.
                    Makes no changes.
  status [file...]  Report per-file diversion/patched/in-sync state.

  --root <dir>      Resolve every path under <dir> instead of /, and pass
                    --root <dir> through to dpkg-divert. Intended for
                    running 'verify' (and 'status') against an extracted
                    package tree in CI, without touching a live system;
                    apply/remove also honor it for the same reason.

file arguments (optional; default: all eight) may be given as the short
key, the diff's basename, the path relative to ${BASE_PERL5}, the
absolute path, or the bare basename. Known files:
EOF
    local entry key relpath difffile marker
    for entry in "${LIFECYCLE_FILES[@]}"; do
        IFS='|' read -r key relpath difffile marker <<<"$entry"
        printf '  %-18s %s  (%s)\n' "$key" "$relpath" "$difffile"
    done
}

main() {
    local -a positional=()
    while [ "$#" -gt 0 ]; do
        case "$1" in
            --root)
                [ "$#" -ge 2 ] || die "--root requires an argument"
                ROOT_DIR="${2%/}"
                shift 2
                ;;
            --root=*)
                ROOT_DIR="${1#--root=}"
                ROOT_DIR="${ROOT_DIR%/}"
                shift
                ;;
            -h|--help)
                usage
                exit 0
                ;;
            --)
                shift
                while [ "$#" -gt 0 ]; do
                    positional+=("$1")
                    shift
                done
                ;;
            -*)
                die "unknown option: $1 (see --help)"
                ;;
            *)
                positional+=("$1")
                shift
                ;;
        esac
    done

    if [ "${#positional[@]}" -eq 0 ]; then
        usage
        exit 2
    fi

    local cmd="${positional[0]}"
    local -a file_args=("${positional[@]:1}")

    local -a SELECTED=()
    select_entries "${file_args[@]}"

    case "$cmd" in
        apply)  cmd_apply ;;
        remove) cmd_remove ;;
        verify) cmd_verify ;;
        status) cmd_status ;;
        *) usage; exit 2 ;;
    esac
}

main "$@"
