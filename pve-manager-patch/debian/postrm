#!/bin/sh
# postrm snippet for the pve-meta package - ensures the divert is undone
# and the loader file removed when the package is removed/purged, so the
# host reverts to a fully stock pve-manager index.html.tpl.
set -e

PVE_META_PATCH=/usr/sbin/pve-meta-patch

case "$1" in
    remove|purge)
        if [ -x "$PVE_META_PATCH" ]; then
            "$PVE_META_PATCH" remove || {
                echo "pve-meta: warning: pve-meta-patch remove failed, index.html.tpl diversion may still be active." >&2
            }
        fi
        ;;
    upgrade|failed-upgrade|abort-install|abort-upgrade|disappear)
        ;;
    *)
        ;;
esac

#DEBHELPER#

exit 0
